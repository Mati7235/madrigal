import { Shape, Type } from "../tokens.slint";
import { Cover } from "cover.slint";
import { Icon, Icons } from "icons.slint";

export component M3Card inherits Rectangle {
    in property<string> title;
    in property<string> subtitle;
    in property<bool> elevated: true;
    in property<bool> media: false;
    in property<image> cover;
    in property<color> fill;
    in property<color> art-fill;
    in property<color> title-color;
    in property<color> subtitle-color;
    in property<color> shadow-color;
    callback clicked();

    accessible-label: root.title;
    accessible-role: AccessibleRole.button;

    property<bool> lit: root.elevated && !root.media;

    border-radius: root.media ? Shape.medium : Shape.large;
    background: root.fill;
    drop-shadow-color: root.lit ? root.shadow-color : transparent;
    drop-shadow-blur: !root.lit ? 0px : card-touch.has-hover ? 12px : 3px;
    drop-shadow-offset-y: !root.lit ? 0px : card-touch.has-hover ? 4px : 1px;
    animate background { duration: 100ms; easing: ease-in-out; }
    animate drop-shadow-blur { duration: 200ms; easing: ease-out; }
    animate drop-shadow-offset-y { duration: 200ms; easing: ease-out; }

    hover-tint := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        background: root.title-color;
        opacity: card-touch.has-hover ? (root.media ? 0.14 : 0.05) : 0;
        animate opacity { duration: 100ms; easing: ease-in-out; }
    }

    if (root.media) : media-col := VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: start;

        media-art := Cover {
            width: 100%;
            height: 118px;
            size: 118px;
            radius: 8px;
            source: root.cover;
        }

        media-title := Text {
            text: root.title;
            color: root.title-color;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }

        media-sub := Text {
            text: root.subtitle;
            color: root.subtitle-color;
            font-size: Type.label-small.size;
            font-weight: 400;
            overflow: elide;
        }
    }

    if (!root.media) : text-col := VerticalLayout {
        padding: 16px;
        spacing: 4px;
        alignment: start;

        card-title := Text {
            text: root.title;
            color: root.title-color;
            font-size: Type.title-large.size;
            font-weight: Type.title-large.weight;
            overflow: elide;
        }

        card-sub := Text {
            text: root.subtitle;
            color: root.subtitle-color;
            font-size: Type.body-medium.size;
            overflow: elide;
        }
    }

    card-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component M3Chip inherits Rectangle {
    in property<string> text;
    in property<bool> selected: false;
    in property<color> selected-fill;
    in property<color> selected-content;
    in property<color> unselected-content;
    in property<color> unselected-line;
    callback clicked();

    accessible-label: root.text;
    accessible-role: AccessibleRole.button;

    height: 32px;
    border-radius: self.height / 2;
    background: root.selected ? root.selected-fill : transparent;
    border-width: root.selected ? 0px : 1px;
    border-color: root.unselected-line;
    animate background { duration: 150ms; easing: ease-in-out; }

    state-layer := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        background: root.selected ? root.selected-content : root.unselected-content;
        opacity: chip-touch.has-hover ? 0.08 : 0;
        animate opacity { duration: 100ms; easing: ease-in-out; }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;

        mark-frame := Rectangle {
            width: root.selected ? 14px : 0px;
            visible: root.selected;
            VerticalLayout {
                alignment: center;
                chip-mark := Icon {
                    source: Icons.check;
                    colorize: root.selected-content;
                    icon-size: 14px;
                    visible: root.selected;
                }
            }
        }

        chip-label := Text {
            text: root.text;
            color: root.selected ? root.selected-content : root.unselected-content;
            font-size: Type.label-large.size;
            font-weight: Type.label-large.weight;
            vertical-alignment: center;
            animate color { duration: 100ms; easing: ease-in-out; }
        }
    }

    chip-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
