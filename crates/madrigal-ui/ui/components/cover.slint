import { Palette, Light } from "../tokens.slint";
import { Icon, Icons } from "icons.slint";

export component Cover inherits Rectangle {
    in property<image> source;
    in property<length> size: 48px;
    in property<length> radius: 10px;
    in property<bool> round: false;
    in property<Palette> palette: Light.palette;

    width: root.size;
    height: root.size;
    border-radius: root.round ? min(root.width, root.height) / 2 : root.radius;
    clip: true;
    background: root.palette.surface-container-high;

    placeholder := Icon {
        source: Icons.music-2;
        colorize: root.palette.on-surface-variant;
        icon-size: min(root.width, root.height) * 0.42;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
    }

    art := Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
        visible: root.source.width > 0;
    }
}
