import { Font, Shape, Type } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { Cover } from "cover.slint";
import { M3IconButton } from "buttons.slint";
import { Icon, Icons } from "icons.slint";

export component M3ListItem inherits Rectangle {
    in property<string> title;
    in property<string> subtitle;
    in property<string> duration;
    in property<string> action-label;
    in property<image> cover;
    in property<bool> active: false;
    in property<float> progress: -1;
    in property<image> action-icon;
    in property<bool> action-visible: false;
    in property<bool> menu: false;
    in property<color> row-bg;
    in property<color> active-bg;
    in property<color> action-bg;
    in property<color> title-color;
    in property<color> subtitle-color;
    in property<color> accent;
    in property<color> progress-track;
    in property<color> progress-fill;
    callback action();
    callback action-clicked();
    callback menu-clicked(length, length);

    accessible-label: root.title;
    accessible-role: AccessibleRole.list-item;

    height: 54px;
    border-radius: Shape.small;
    background: root.active ? root.active-bg : item-touch.has-hover ? root.row-bg : transparent;
    animate background { duration: 100ms; easing: ease-in-out; }

    item-focus := FocusScope {
        focus-on-click: false;
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.action();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    item-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.action(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right && root.menu) {
                root.menu-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 16px;
        spacing: 12px;

        art-frame := Rectangle {
            width: 36px;
            VerticalLayout {
                alignment: center;
                art := Cover {
                    size: 36px;
                    radius: 8px;
                    source: root.cover;
                }
            }
        }

        texts := VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;

            item-title := Text {
                text: root.title;
                color: root.active ? root.accent : root.title-color;
                font-size: Type.title-small.size;
                font-family: Font.body;
                font-weight: Type.title-small.weight;
                overflow: elide;
            }

            item-sub := Text {
                text: root.subtitle;
                color: root.subtitle-color;
                font-size: Type.label-small.size;
                font-family: Type.label-small.family;
                font-weight: 400;
                overflow: elide;
            }
        }

        if (root.progress >= 0) : download-frame := Rectangle {
            width: 120px;
            VerticalLayout {
                alignment: center;
                download-bar := Rectangle {
                    width: 120px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.progress-track;

                    download-fill := Rectangle {
                        width: parent.width * clamp(root.progress, 0, 1);
                        height: 100%;
                        border-radius: 3px;
                        background: root.progress-fill;
                    }
                }
            }
        }

        item-duration := Text {
            text: root.duration;
            color: root.subtitle-color;
            font-size: Type.label-small.size;
            font-family: Type.label-small.family;
            font-weight: 400;
            vertical-alignment: center;
        }

        item-action := Text {
            text: root.action-label;
            color: root.title-color;
            font-size: Type.body-large.size;
            font-family: Type.body-large.family;
            vertical-alignment: center;
            visible: !root.action-visible && (root.active || item-touch.has-hover);
            animate opacity { duration: 100ms; easing: ease-in-out; }
        }

        if (root.action-visible) : action-frame := Rectangle {
            width: 40px;
            VerticalLayout {
                alignment: center;
                action-button := M3IconButton {
                    icon: root.action-icon;
                    icon-size: 20px;
                    fill: root.action-bg;
                    content: root.accent;
                    state-on-surface: root.title-color;
                    accessible-label: root.action-label;
                    clicked => { root.action-clicked(); }
                }
            }
        }

        if (root.menu) : menu-frame := Rectangle {
            width: 40px;
            VerticalLayout {
                alignment: center;

                menu-focus := FocusScope {
                    width: 40px;
                    height: 40px;

                    menu-ring := Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: 20px;
                        border-width: menu-focus.has-focus ? 2px : 0px;
                        border-color: root.accent;
                    }

                    menu-button := M3IconButton {
                        icon: Icons.ellipsis-vertical;
                        icon-size: 18px;
                        fill: transparent;
                        content: root.subtitle-color;
                        state-on-surface: root.title-color;
                        accessible-label: I18n.trl(I18n.lang, "action.more");
                        clicked => {
                            root.menu-clicked(menu-button.absolute-position.x, menu-button.absolute-position.y + menu-button.height);
                        }
                    }

                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.menu-clicked(menu-button.absolute-position.x, menu-button.absolute-position.y + menu-button.height);
                            return EventResult.accept;
                        }
                        return EventResult.reject;
                    }
                }
            }
        }
    }

    if (item-focus.has-focus) : focus-ring := Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: root.border-radius - 2px;
        border-width: 2px;
        border-color: root.title-color;
    }
}
