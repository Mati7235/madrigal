import { Shape, Type } from "../tokens.slint";
import { Cover } from "cover.slint";
import { M3IconButton } from "buttons.slint";

export component M3ListItem inherits Rectangle {
    in property<string> title;
    in property<string> subtitle;
    in property<string> duration;
    in property<string> action-label;
    in property<image> cover;
    in property<bool> active: false;
    in property<float> progress: -1;
    in property<image> action-icon;
    in property<bool> action-visible: false;
    in property<color> row-bg;
    in property<color> active-bg;
    in property<color> action-bg;
    in property<color> title-color;
    in property<color> subtitle-color;
    in property<color> accent;
    in property<color> progress-track;
    in property<color> progress-fill;
    callback action();
    callback action-clicked();

    accessible-label: root.title;
    accessible-role: AccessibleRole.list-item;

    height: 54px;
    border-radius: Shape.small;
    background: root.active ? root.active-bg : item-touch.has-hover ? root.row-bg : transparent;
    animate background { duration: 100ms; easing: ease-in-out; }

    item-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.action(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 16px;
        spacing: 12px;

        art-frame := Rectangle {
            width: 36px;
            VerticalLayout {
                alignment: center;
                art := Cover {
                    size: 36px;
                    radius: 8px;
                    source: root.cover;
                }
            }
        }

        texts := VerticalLayout {
            spacing: 2px;
            alignment: center;
            horizontal-stretch: 1;

            item-title := Text {
                text: root.title;
                color: root.active ? root.accent : root.title-color;
                font-size: Type.title-small.size;
                font-weight: Type.title-small.weight;
                overflow: elide;
            }

            item-sub := Text {
                text: root.subtitle;
                color: root.subtitle-color;
                font-size: Type.label-small.size;
                font-weight: 400;
                overflow: elide;
            }
        }

        if (root.progress >= 0) : download-frame := Rectangle {
            width: 120px;
            VerticalLayout {
                alignment: center;
                download-bar := Rectangle {
                    width: 120px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.progress-track;

                    download-fill := Rectangle {
                        width: parent.width * clamp(root.progress, 0, 1);
                        height: 100%;
                        border-radius: 3px;
                        background: root.progress-fill;
                    }
                }
            }
        }

        item-duration := Text {
            text: root.duration;
            color: root.subtitle-color;
            font-size: Type.label-small.size;
            font-weight: 400;
            vertical-alignment: center;
        }

        item-action := Text {
            text: root.action-label;
            color: root.title-color;
            font-size: Type.body-large.size;
            vertical-alignment: center;
            visible: !root.action-visible && (root.active || item-touch.has-hover);
            animate opacity { duration: 100ms; easing: ease-in-out; }
        }

        if (root.action-visible) : action-frame := Rectangle {
            width: 40px;
            VerticalLayout {
                alignment: center;
                action-button := M3IconButton {
                    icon: root.action-icon;
                    icon-size: 20px;
                    fill: root.action-bg;
                    content: root.accent;
                    state-on-surface: root.title-color;
                    accessible-label: root.action-label;
                    clicked => { root.action-clicked(); }
                }
            }
        }
    }
}
