import { Shape, Type } from "../tokens.slint";

export component M3Switch inherits Rectangle {
    in-out property<bool> checked;
    in property<bool> enabled: true;
    in property<string> label;
    in property<color> on-track;
    in property<color> on-thumb;
    in property<color> off-track;
    in property<color> off-line;
    in property<color> off-thumb;
    in property<color> state-on-surface;
    callback toggled(bool);

    accessible-label: root.label;
    accessible-role: AccessibleRole.switch;

    width: 52px;
    height: 32px;
    border-radius: self.height / 2;
    background: !root.enabled ? root.state-on-surface.with-alpha(0.12) : root.checked ? root.on-track : root.off-track;
    border-width: root.checked || !root.enabled ? 0px : 2px;
    border-color: root.off-line;
    animate background { duration: 200ms; easing: ease-in-out; }

    thumb := Rectangle {
        width: !root.enabled ? 16px : root.checked ? 24px : 16px;
        height: !root.enabled ? 16px : root.checked ? 24px : 16px;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: !root.enabled ? root.state-on-surface.with-alpha(0.38) : root.checked ? root.on-thumb : root.off-thumb;
        animate x { duration: 200ms; easing: ease-out; }
        animate width { duration: 200ms; easing: ease-out; }
        animate height { duration: 200ms; easing: ease-out; }
        animate background { duration: 200ms; easing: ease-in-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component M3Checkbox inherits Rectangle {
    in-out property<bool> checked;
    in property<bool> enabled: true;
    in property<string> label;
    in property<color> selected-fill;
    in property<color> selected-content;
    in property<color> unselected-line;
    in property<color> state-on-surface;
    callback toggled(bool);

    accessible-label: root.label;
    accessible-role: AccessibleRole.checkbox;

    width: 40px;
    height: 40px;
    background: transparent;

    box := Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 5px;
        background: !root.enabled ? transparent : root.checked ? root.selected-fill : transparent;
        border-width: !root.enabled || root.checked ? 0px : 2px;
        border-color: root.unselected-line;
        animate background { duration: 150ms; easing: ease-in-out; }

        mark := Text {
            text: "✓";
            color: !root.enabled ? root.state-on-surface.with-alpha(0.38) : root.checked ? root.selected-content : transparent;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component M3Slider inherits Rectangle {
    in-out property<float> value;
    in property<bool> enabled: true;
    in property<string> label;
    in property<color> active-track;
    in property<color> inactive-track;
    in property<color> handle-color;
    in property<color> state-on-surface;
    callback changed(float);

    accessible-label: root.label;
    accessible-role: AccessibleRole.slider;

    height: 64px;
    background: transparent;

    property<length> bar-w: self.width - 32px;

    inactive := Rectangle {
        x: 16px;
        y: (parent.height - 16px) / 2;
        width: root.bar-w;
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? root.inactive-track : root.state-on-surface.with-alpha(0.12);
        animate background { duration: 150ms; easing: ease-in-out; }
    }

    active := Rectangle {
        x: 16px;
        y: (parent.height - 16px) / 2;
        width: root.bar-w * clamp(root.value, 0, 1);
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? root.active-track : root.state-on-surface.with-alpha(0.38);
        animate background { duration: 150ms; easing: ease-in-out; }
    }

    handle := Rectangle {
        width: touch.pressed ? 2px : 4px;
        height: 44px;
        x: 16px + (root.bar-w - self.width) * clamp(root.value, 0, 1);
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.enabled ? root.handle-color : root.state-on-surface.with-alpha(0.38);
        animate width { duration: 150ms; easing: ease-in-out; }
        animate background { duration: 150ms; easing: ease-in-out; }
    }

    value-label := Text {
        text: Math.round(root.value * 100) + "%";
        color: root.enabled ? root.handle-color : root.state-on-surface.with-alpha(0.38);
        font-size: Type.label-large.size;
        font-weight: Type.label-large.weight;
        x: 0px;
        y: 0px;
        width: 48px;
        height: 16px;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.value = clamp((touch.mouse-x - 16px) / root.bar-w, 0, 1);
            root.changed(root.value);
        }
        moved => {
            if (touch.pressed) {
                root.value = clamp((touch.mouse-x - 16px) / root.bar-w, 0, 1);
                root.changed(root.value);
            }
        }
    }
}
