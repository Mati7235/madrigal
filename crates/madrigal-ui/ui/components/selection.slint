import { Shape, Type } from "../tokens.slint";
import { Icon, Icons } from "icons.slint";

export component M3SegmentedButton inherits Rectangle {
    in property<[string]> options;
    in-out property<int> selected: 0;
    in property<color> track;
    in property<color> selected-fill;
    in property<color> selected-content;
    in property<color> content;
    in property<color> line;
    in property<color> state-on-surface;
    callback selected-changed(int);

    height: 40px;
    border-radius: self.height / 2;
    background: root.track;
    border-width: 1px;
    border-color: root.line;

    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options : segment := Rectangle {
            horizontal-stretch: 1;
            border-radius: (root.height - 6px) / 2;
            background: root.selected == i ? root.selected-fill : transparent;
            animate background { duration: 150ms; easing: ease-in-out; }

            accessible-label: option;
            accessible-role: AccessibleRole.button;

            segment-layer := Rectangle {
                width: 100%;
                height: 100%;
                border-radius: parent.border-radius;
                background: root.selected == i ? root.selected-content : root.content;
                opacity: segment-touch.has-hover && root.selected != i ? 0.08 : 0;
                animate opacity { duration: 100ms; easing: ease-in-out; }
            }

            segment-label := Text {
                text: option;
                color: root.selected == i ? root.selected-content : root.content;
                font-size: Type.label-large.size;
                font-family: Type.label-large.family;
                font-weight: Type.label-large.weight;
                letter-spacing: Type.label-large.tracking;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                animate color { duration: 100ms; easing: ease-in-out; }
            }

            segment-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.selected != i) {
                        root.selected = i;
                        root.selected-changed(i);
                    }
                }
            }

            segment-focus := FocusScope {
                focus-on-click: false;
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (event.text == Key.Space || event.text == Key.Return) {
                        if (root.selected != i) {
                            root.selected = i;
                            root.selected-changed(i);
                        }
                        return EventResult.accept;
                    }
                    if (event.text == Key.LeftArrow && i > 0) {
                        root.selected = i - 1;
                        root.selected-changed(i - 1);
                        return EventResult.accept;
                    }
                    if (event.text == Key.RightArrow && i < root.options.length - 1) {
                        root.selected = i + 1;
                        root.selected-changed(i + 1);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }

            if (segment-focus.has-focus) : focus-ring := Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: parent.border-radius - 2px;
                border-width: 2px;
                border-color: root.state-on-surface;
            }
        }
    }
}

export component M3Switch inherits Rectangle {
    in-out property<bool> checked;
    in property<bool> enabled: true;
    in property<string> label;
    in property<color> on-track;
    in property<color> on-thumb;
    in property<color> off-track;
    in property<color> off-line;
    in property<color> off-thumb;
    in property<color> state-on-surface;
    callback toggled(bool);

    accessible-label: root.label;
    accessible-role: AccessibleRole.switch;

    width: 52px;
    height: 32px;
    border-radius: self.height / 2;
    background: !root.enabled ? root.state-on-surface.with-alpha(0.12) : root.checked ? root.on-track : root.off-track;
    border-width: root.checked || !root.enabled ? 0px : 2px;
    border-color: root.off-line;
    animate background { duration: 200ms; easing: ease-in-out; }

    thumb := Rectangle {
        width: !root.enabled ? 16px : root.checked ? 24px : 16px;
        height: !root.enabled ? 16px : root.checked ? 24px : 16px;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: !root.enabled ? root.state-on-surface.with-alpha(0.38) : root.checked ? root.on-thumb : root.off-thumb;
        animate x { duration: 200ms; easing: ease-out; }
        animate width { duration: 200ms; easing: ease-out; }
        animate height { duration: 200ms; easing: ease-out; }
        animate background { duration: 200ms; easing: ease-in-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    switch-focus := FocusScope {
        focus-on-click: false;
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    if (switch-focus.has-focus) : focus-ring := Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: root.border-radius - 2px;
        border-width: 2px;
        border-color: root.state-on-surface;
    }
}

export component M3Checkbox inherits Rectangle {
    in-out property<bool> checked;
    in property<bool> enabled: true;
    in property<string> label;
    in property<color> selected-fill;
    in property<color> selected-content;
    in property<color> unselected-line;
    in property<color> state-on-surface;
    callback toggled(bool);

    accessible-label: root.label;
    accessible-role: AccessibleRole.checkbox;

    width: 40px;
    height: 40px;
    background: transparent;

    box := Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 5px;
        background: !root.enabled ? transparent : root.checked ? root.selected-fill : transparent;
        border-width: !root.enabled || root.checked ? 0px : 2px;
        border-color: root.unselected-line;
        animate background { duration: 150ms; easing: ease-in-out; }

        mark := Icon {
            source: Icons.check;
            colorize: !root.enabled ? root.state-on-surface.with-alpha(0.38) : root.checked ? root.selected-content : transparent;
            icon-size: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    check-focus := FocusScope {
        focus-on-click: false;
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    if (check-focus.has-focus) : focus-ring := Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 18px;
        border-width: 2px;
        border-color: root.state-on-surface;
    }
}

export component M3Slider inherits Rectangle {
    in-out property<float> value;
    in property<bool> enabled: true;
    in property<string> label;
    in property<bool> show-value: true;
    in property<color> active-track;
    in property<color> inactive-track;
    in property<color> handle-color;
    in property<color> state-on-surface;
    callback changed(float);

    accessible-label: root.label;
    accessible-role: AccessibleRole.slider;

    height: 64px;
    background: transparent;

    property<length> bar-w: self.width - 32px;

    inactive := Rectangle {
        x: 16px;
        y: (parent.height - 16px) / 2;
        width: root.bar-w;
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? root.inactive-track : root.state-on-surface.with-alpha(0.12);
        animate background { duration: 150ms; easing: ease-in-out; }
    }

    active := Rectangle {
        x: 16px;
        y: (parent.height - 16px) / 2;
        width: root.bar-w * clamp(root.value, 0, 1);
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? root.active-track : root.state-on-surface.with-alpha(0.38);
        animate background { duration: 150ms; easing: ease-in-out; }
    }

    handle := Rectangle {
        width: touch.pressed ? 2px : 4px;
        height: 44px;
        x: 16px + (root.bar-w - self.width) * clamp(root.value, 0, 1);
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.enabled ? root.handle-color : root.state-on-surface.with-alpha(0.38);
        animate width { duration: 150ms; easing: ease-in-out; }
        animate background { duration: 150ms; easing: ease-in-out; }
    }

    if (root.show-value) : value-label := Text {
        text: Math.round(root.value * 100) + "%";
        visible: root.show-value;
        color: root.enabled ? root.handle-color : root.state-on-surface.with-alpha(0.38);
        font-size: Type.label-large.size;
        font-family: Type.label-large.family;
        font-weight: Type.label-large.weight;
        x: 0px;
        y: 0px;
        width: 48px;
        height: 16px;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.value = clamp((touch.mouse-x - 16px) / root.bar-w, 0, 1);
            root.changed(root.value);
        }
        moved => {
            if (touch.pressed) {
                root.value = clamp((touch.mouse-x - 16px) / root.bar-w, 0, 1);
                root.changed(root.value);
            }
        }
    }

    slider-focus := FocusScope {
        focus-on-click: false;
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.value = clamp(root.value - 0.05, 0, 1);
                root.changed(root.value);
                return EventResult.accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.value = clamp(root.value + 0.05, 0, 1);
                root.changed(root.value);
                return EventResult.accept;
            }
            if (event.text == Key.Home) {
                root.value = 0;
                root.changed(root.value);
                return EventResult.accept;
            }
            if (event.text == Key.End) {
                root.value = 1;
                root.changed(root.value);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    if (slider-focus.has-focus) : focus-ring := Rectangle {
        x: 14px;
        y: (parent.height - 20px) / 2;
        width: parent.width - 28px;
        height: 20px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.handle-color;
    }
}
