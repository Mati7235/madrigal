import { Font, Palette, Type } from "../../tokens.slint";
import { I18n } from "../../i18n.slint";
import { M3Chip, M3Card, M3MoodTile } from "../../components/cards.slint";
import { CatalogItem, CatalogSection, DetailKind, DetailRef, MoodEntry } from "refs.slint";
import { SectionView } from "section.slint";

export component ExplorePage inherits Rectangle {
    in property<Palette> palette;
    in property<[MoodEntry]> moods-left;
    in property<[MoodEntry]> moods-right;
    in property<string> charts-id: "charts:";
    in-out property<int> releases-tab: 0;
    in property<[CatalogItem]> releases-albums;
    in property<[CatalogItem]> releases-videos;
    in property<[CatalogSection]> browse-sections;
    property<int> releases-count: root.releases-tab == 0 ? root.releases-albums.length : root.releases-videos.length;
    property<length> mood-tile-width: (root.width - 2 * 24px - 3 * 12px) / 4;

    callback detail-requested(DetailRef);
    callback play-requested(CatalogItem);

    background: root.palette.surface;
    accessible-role: text;
    accessible-label: I18n.trl(I18n.lang, "nav.explore");

    page-flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: explore-col.preferred-height;

        explore-col := VerticalLayout {
            padding: 24px;
            spacing: 12px;

            explore-title := Text {
                text: I18n.trl(I18n.lang, "nav.explore");
                color: root.palette.on-surface;
                font-size: 28px;
                font-family: Font.title;
                font-weight: 700;
            }

            explore-desc := Text {
                text: I18n.trl(I18n.lang, "explore.description");
                color: root.palette.on-surface-variant;
                font-size: Type.body-medium.size;
                font-family: Type.body-medium.family;
                wrap: word-wrap;
            }

            moods-title := Text {
                text: I18n.trl(I18n.lang, "catalog.moods");
                color: root.palette.on-surface;
                font-size: Type.title-medium.size;
                font-family: Type.title-medium.family;
                font-weight: Type.title-medium.weight;
            }

            moods-grid := GridLayout {
                spacing: 12px;
                for mood[i] in root.moods-left : mood-chip-l := M3MoodTile {
                    width: root.mood-tile-width;
                    row: i / 2;
                    col: Math.mod(i, 2) * 2;
                    text: mood.title;
                    fill: root.palette.surface-container-low;
                    content: root.palette.on-surface;
                    line: root.palette.outline-variant;
                    focus-color: root.palette.primary;
                    clicked => { root.detail-requested({ kind: DetailKind.browse, id: mood.params }); }
                }
                for mood[i] in root.moods-right : mood-chip-r := M3MoodTile {
                    width: root.mood-tile-width;
                    row: i / 2;
                    col: Math.mod(i, 2) * 2 + 1;
                    text: mood.title;
                    fill: root.palette.surface-container-low;
                    content: root.palette.on-surface;
                    line: root.palette.outline-variant;
                    focus-color: root.palette.primary;
                    clicked => { root.detail-requested({ kind: DetailKind.browse, id: mood.params }); }
                }
            }

            charts-card := M3Card {
                width: 150px;
                height: 190px;
                media: true;
                title: I18n.trl(I18n.lang, "catalog.charts");
                subtitle: I18n.trl(I18n.lang, "explore.description");
                fill: root.palette.surface-container-low;
                art-fill: root.palette.surface-container-high;
                title-color: root.palette.on-surface;
                subtitle-color: root.palette.on-surface-variant;
                shadow-color: root.palette.shadow;
                clicked => { root.detail-requested({ kind: DetailKind.browse, id: root.charts-id }); }
            }

            releases-head := HorizontalLayout {
                spacing: 12px;
                alignment: start;

                releases-title := Text {
                    text: I18n.trl(I18n.lang, "home.section.newReleases");
                    color: root.palette.on-surface;
                    font-size: 20px;
                    font-family: Font.title;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                for i in 2 : rel-chip := M3Chip {
                    text: i == 0 ? I18n.trl(I18n.lang, "catalog.albums") : I18n.trl(I18n.lang, "catalog.releases.videos");
                    selected: root.releases-tab == i;
                    selected-fill: root.palette.secondary-container;
                    selected-content: root.palette.on-secondary-container;
                    unselected-content: root.palette.on-surface-variant;
                    unselected-line: root.palette.outline-variant;
                    clicked => { root.releases-tab = i; }
                }
            }

            if (root.releases-tab == 0) : rel-albums-rail := Flickable {
                height: 190px;

                rel-albums-row := HorizontalLayout {
                    spacing: 12px;
                    for album[i] in root.releases-albums : rel-album-card := M3Card {
                        width: 150px;
                        height: 190px;
                        media: true;
                        title: album.title;
                        subtitle: album.subtitle;
                        cover: album.cover;
                        fill: root.palette.surface-container-low;
                        art-fill: root.palette.surface-container-high;
                        title-color: root.palette.on-surface;
                        subtitle-color: root.palette.on-surface-variant;
                        shadow-color: root.palette.shadow;
                        clicked => { root.detail-requested({ kind: album.kind, id: album.id }); }
                    }
                }
            }

            if (root.releases-tab == 1) : rel-videos-rail := Flickable {
                height: 190px;

                rel-videos-row := HorizontalLayout {
                    spacing: 12px;
                    for video[i] in root.releases-videos : rel-video-card := M3Card {
                        width: 150px;
                        height: 190px;
                        media: true;
                        title: video.title;
                        subtitle: video.subtitle;
                        cover: video.cover;
                        fill: root.palette.surface-container-low;
                        art-fill: root.palette.surface-container-high;
                        title-color: root.palette.on-surface;
                        subtitle-color: root.palette.on-surface-variant;
                        shadow-color: root.palette.shadow;
                        clicked => { root.play-requested(video); }
                    }
                }
            }

            browse-block := VerticalLayout {
                spacing: 16px;
                visible: root.browse-sections.length > 0;
                for sec[s] in root.browse-sections : browse-view := SectionView {
                    palette: root.palette;
                    section: sec;
                    detail-requested(ref) => { root.detail-requested(ref); }
                    play-requested(item) => { root.play-requested(item); }
                }
            }

            explore-empty := Text {
                text: I18n.trl(I18n.lang, "explore.empty");
                color: root.palette.on-surface-variant;
                font-size: Type.body-large.size;
                font-family: Type.body-large.family;
                horizontal-alignment: center;
                visible: root.moods-left.length == 0 && root.moods-right.length == 0 && root.browse-sections.length == 0 && root.releases-albums.length == 0;
            }
        }
    }
}
