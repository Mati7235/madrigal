import { Palette, Type } from "../../tokens.slint";
import { I18n } from "../../i18n.slint";
import { M3Chip, M3Card } from "../../components/cards.slint";
import { M3ListItem } from "../../components/rows.slint";
import { CatalogItem, CatalogSection, DetailRef } from "refs.slint";
import { SectionView } from "section.slint";

export component HomePage inherits Rectangle {
    in property<Palette> palette;
    in property<[string]> chips;
    in-out property<int> current-chip: 0;
    in property<[CatalogSection]> sections;
    in property<[CatalogItem]> quick-picks;
    in property<[CatalogItem]> pins;
    in property<bool> card-layout: true;
    in-out property<int> selected-item: -1;
    property<string> picks-mode: root.card-layout ? "cards" : "list";
    property<bool> is-empty: root.sections.length == 0 && root.quick-picks.length == 0 && root.pins.length == 0;

    callback chip-selected(int);
    callback detail-requested(DetailRef);
    callback play-requested(string);

    background: root.palette.surface;
    accessible-role: text;
    accessible-label: I18n.trl(I18n.lang, "nav.home");

    page-flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: home-col.preferred-height;

        home-col := VerticalLayout {
            padding: 16px;
            spacing: 16px;

            home-chips := HorizontalLayout {
                spacing: 8px;
                visible: root.chips.length > 0;
                for label[i] in root.chips : home-chip := M3Chip {
                    text: label;
                    selected: root.current-chip == i;
                    selected-fill: root.palette.secondary-container;
                    selected-content: root.palette.on-secondary-container;
                    unselected-content: root.palette.on-surface-variant;
                    unselected-line: root.palette.outline-variant;
                    clicked => {
                        root.current-chip = i;
                        root.chip-selected(i);
                    }
                }
            }

            pins-block := VerticalLayout {
                spacing: 8px;
                visible: root.pins.length > 0;
                pins-title := Text {
                    text: I18n.trl(I18n.lang, "catalog.pins");
                    color: root.palette.on-surface;
                    font-size: Type.title-medium.size;
                    font-weight: Type.title-medium.weight;
                }
                pins-row := HorizontalLayout {
                    spacing: 8px;
                    for pin[i] in root.pins : pin-chip := M3Chip {
                        text: pin.title;
                        selected: root.selected-item == 10000 + i;
                        selected-fill: root.palette.tertiary-container;
                        selected-content: root.palette.on-tertiary-container;
                        unselected-content: root.palette.on-surface-variant;
                        unselected-line: root.palette.outline-variant;
                        clicked => {
                            root.selected-item = 10000 + i;
                            root.play-requested(pin.id);
                        }
                    }
                }
            }

            picks-block := VerticalLayout {
                spacing: 8px;
                visible: root.quick-picks.length > 0;
                picks-title := Text {
                    text: I18n.trl(I18n.lang, "catalog.quickPicks");
                    color: root.palette.on-surface;
                    font-size: Type.title-medium.size;
                    font-weight: Type.title-medium.weight;
                }
                if (root.card-layout) : picks-grid := HorizontalLayout {
                    spacing: 12px;
                    for pick[i] in root.quick-picks : pick-card := M3Card {
                        width: 200px;
                        height: 120px;
                        title: pick.title;
                        subtitle: pick.subtitle;
                        fill: root.palette.surface-container-low;
                        title-color: root.palette.on-surface;
                        subtitle-color: root.palette.on-surface-variant;
                        shadow-color: root.palette.shadow;
                        clicked => {
                            root.selected-item = i;
                            root.play-requested(pick.id);
                        }
                    }
                }
                if (!root.card-layout) : picks-list := VerticalLayout {
                    spacing: 2px;
                    for pick[i] in root.quick-picks : pick-row := M3ListItem {
                        title: pick.title;
                        subtitle: pick.subtitle;
                        duration: pick.duration;
                        row-bg: root.palette.surface-container-low;
                        active-bg: root.palette.secondary-container;
                        title-color: root.palette.on-surface;
                        subtitle-color: root.palette.on-surface-variant;
                        progress-track: root.palette.surface-container-highest;
                        progress-fill: root.palette.primary;
                        action => {
                            root.selected-item = i;
                            root.play-requested(pick.id);
                        }
                    }
                }
            }

            sections-block := VerticalLayout {
                spacing: 16px;
                for sec[s] in root.sections : sec-view := SectionView {
                    palette: root.palette;
                    section: sec;
                    detail-requested(ref) => { root.detail-requested(ref); }
                    play-requested(id) => {
                        root.selected-item = 20000 + s;
                        root.play-requested(id);
                    }
                }
            }

            home-empty := Text {
                text: I18n.trl(I18n.lang, "home.empty");
                color: root.palette.on-surface-variant;
                font-size: Type.body-large.size;
                horizontal-alignment: center;
                visible: root.is-empty;
            }
        }
    }
}
