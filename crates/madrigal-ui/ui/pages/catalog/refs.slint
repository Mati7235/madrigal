export enum DetailKind { artist, album, playlist, podcast, browse }

export struct DetailRef {
    kind: DetailKind,
    id: string,
    title: string,
}

export struct CatalogItem {
    kind: DetailKind,
    id: string,
    title: string,
    subtitle: string,
    duration: string,
    playable: bool,
    artist: string,
    album: string,
    thumbnail: string,
    cover: image,
    duration-secs: int,
}

export struct CatalogSection {
    title: string,
    items: [CatalogItem],
}

export struct MoodEntry {
    title: string,
    params: string,
}
