import { Font, Palette, Type } from "../../tokens.slint";
import { I18n } from "../../i18n.slint";
import { M3Chip, M3Card } from "../../components/cards.slint";
import { M3ListItem } from "../../components/rows.slint";
import { ScrollView } from "std-widgets.slint";
import { CatalogItem, DetailRef } from "refs.slint";

export component SearchPage inherits FocusScope {
    in property<Palette> palette;
    in-out property<string> query: "";
    in property<[string]> suggestions;
    in-out property<int> suggestion-index: -1;
    in-out property<int> filter-tab: 0;
    in property<[CatalogItem]> results;
    in-out property<int> source: 1;
    property<bool> show-empty: root.query != "" && root.results.length == 0;
    property<bool> tight: root.height < 420px;
    property<int> suggestion-rows: root.tight ? 1 : 3;

    callback suggestion-accepted(string);
    callback key-dispatched(string);
    callback filter-selected(int);
    callback source-selected(int);
    callback detail-requested(DetailRef);
    callback play-requested(CatalogItem);

    key-dispatched(dir) => {
        if (dir == "down") {
            if (root.suggestions.length > 0) {
                root.suggestion-index = Math.min(root.suggestion-index + 1, root.suggestions.length - 1);
            }
        } else if (dir == "up") {
            if (root.suggestions.length > 0) {
                root.suggestion-index = Math.max(root.suggestion-index - 1, 0);
            }
        } else if (dir == "enter") {
            if (root.suggestion-index >= 0 && root.suggestion-index < root.suggestions.length) {
                root.query = root.suggestions[root.suggestion-index];
                root.suggestion-accepted(root.query);
            }
        }
    }

    key-pressed(event) => {
        if (event.text == Key.DownArrow) {
            root.key-dispatched("down");
            return accept;
        }
        if (event.text == Key.UpArrow) {
            root.key-dispatched("up");
            return accept;
        }
        if (event.text == "\n") {
            root.key-dispatched("enter");
            return accept;
        }
        return reject;
    }

    Rectangle {
        background: root.palette.surface;

        search-col := VerticalLayout {
            padding: 16px;
            spacing: root.tight ? 6px : 12px;

            search-title := Text {
                text: I18n.trl(I18n.lang, "explore.search");
                color: root.palette.on-surface;
                font-size: 26px;
                font-family: Font.title;
                font-weight: 700;
                overflow: elide;
            }

            if (!root.tight) : search-sub := Text {
                text: I18n.trl(I18n.lang, "search.hint");
                color: root.palette.on-surface-variant;
                font-size: 13px;
                font-family: Font.body;
                font-weight: 400;
                height: self.preferred-height;
                overflow: elide;
            }

            source-row := HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for i in 2 : source-chip := M3Chip {
                    text: i == 0 ? I18n.trl(I18n.lang, "source.local") : I18n.trl(I18n.lang, "catalog.online");
                    selected: root.source == i;
                    selected-fill: root.palette.secondary-container;
                    selected-content: root.palette.on-secondary-container;
                    unselected-content: root.palette.on-surface-variant;
                    unselected-line: root.palette.outline-variant;
                    clicked => {
                        root.source = i;
                        root.source-selected(i);
                    }
                }
            }

            if (root.suggestions.length > 0) : suggestions-block := VerticalLayout {
                spacing: 2px;
                vertical-stretch: 0;
                if (!root.tight) : suggestions-title := Text {
                    text: I18n.trl(I18n.lang, "catalog.suggestions");
                    color: root.palette.on-surface;
                    font-size: Type.title-medium.size;
                    font-family: Type.title-medium.family;
                    font-weight: Type.title-medium.weight;
                    height: self.preferred-height;
                    overflow: elide;
                }
                suggestions-scroll := ScrollView {
                    height: Math.min(root.suggestions.length, root.suggestion-rows) * 54px;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    suggestions-list := VerticalLayout {
                        spacing: 2px;
                        for sug[i] in root.suggestions : sug-row := M3ListItem {
                            title: sug;
                            subtitle: "";
                            duration: "";
                            active: root.suggestion-index == i;
                            row-bg: root.palette.surface-container-low;
                            active-bg: root.palette.secondary-container;
                            title-color: root.palette.on-surface;
                            subtitle-color: root.palette.on-surface-variant;
                            accent: root.palette.primary;
                            progress-track: root.palette.surface-container-highest;
                            progress-fill: root.palette.primary;
                            action => {
                                root.suggestion-index = i;
                                root.query = sug;
                                root.suggestion-accepted(sug);
                            }
                        }
                    }
                }
            }

            filter-row := HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for i in 5 : filter-chip := M3Chip {
                    text: i == 0 ? I18n.trl(I18n.lang, "catalog.filter.all") : i == 1 ? I18n.trl(I18n.lang, "catalog.songs") : i == 2 ? I18n.trl(I18n.lang, "catalog.artists") : i == 3 ? I18n.trl(I18n.lang, "catalog.albums") : I18n.trl(I18n.lang, "catalog.playlists");
                    selected: root.filter-tab == i;
                    selected-fill: root.palette.secondary-container;
                    selected-content: root.palette.on-secondary-container;
                    unselected-content: root.palette.on-surface-variant;
                    unselected-line: root.palette.outline-variant;
                    clicked => {
                        root.filter-tab = i;
                        root.filter-selected(i);
                    }
                }
            }

            if (root.results.length > 0) : results-title := Text {
                text: I18n.trl(I18n.lang, "catalog.results");
                color: root.palette.on-surface;
                font-size: Type.title-medium.size;
                font-family: Type.title-medium.family;
                font-weight: Type.title-medium.weight;
                height: self.preferred-height;
            }

            if (root.show-empty) : search-empty := Text {
                text: I18n.trl(I18n.lang, "search.section.empty");
                color: root.palette.on-surface-variant;
                font-size: Type.body-large.size;
                font-family: Type.body-large.family;
                horizontal-alignment: center;
                height: self.preferred-height;
            }

            if (root.query == "" && root.results.length == 0) : history-title := Text {
                text: I18n.trl(I18n.lang, "search.history");
                color: root.palette.on-surface-variant;
                font-size: Type.body-medium.size;
                font-family: Type.body-medium.family;
                height: self.preferred-height;
            }

            results-scroll := ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                results-list := VerticalLayout {
                    spacing: 8px;
                    if (root.filter-tab == 2 || root.filter-tab == 3 || root.filter-tab == 4) : hits-rail := Flickable {
                        height: 190px;

                        hits-row := HorizontalLayout {
                            spacing: 12px;
                            for hit[i] in root.results : hit-row := M3Card {
                                width: 150px;
                                height: 190px;
                                media: true;
                                title: hit.title;
                                subtitle: hit.subtitle;
                                fill: root.palette.surface-container-low;
                                art-fill: root.palette.surface-container-high;
                                title-color: root.palette.on-surface;
                                subtitle-color: root.palette.on-surface-variant;
                                shadow-color: root.palette.shadow;
                                clicked => {
                                    root.detail-requested({ kind: hit.kind, id: hit.id });
                                }
                            }
                        }
                    }
                    if (root.filter-tab == 0 || root.filter-tab == 1) : tracks-list := VerticalLayout {
                        spacing: 2px;
                        for hit[i] in root.results : track-row := M3ListItem {
                            title: hit.title;
                            subtitle: hit.subtitle;
                            duration: hit.duration;
                            row-bg: root.palette.surface-container-low;
                            active-bg: root.palette.secondary-container;
                            title-color: root.palette.on-surface;
                            subtitle-color: root.palette.on-surface-variant;
                            accent: root.palette.primary;
                            progress-track: root.palette.surface-container-highest;
                            progress-fill: root.palette.primary;
                            action => {
                                root.play-requested(hit);
                            }
                        }
                    }
                }
            }
        }
    }
}
