import { Palette, Type } from "../../tokens.slint";
import { M3Card } from "../../components/cards.slint";
import { M3ListItem } from "../../components/rows.slint";
import { CatalogItem, CatalogSection, DetailRef } from "refs.slint";

export component SectionView inherits VerticalLayout {
    in property<Palette> palette;
    in property<CatalogSection> section;
    in property<bool> cards: false;
    callback detail-requested(DetailRef);
    callback play-requested(CatalogItem);

    spacing: 8px;

    sec-title := Text {
        text: root.section.title;
        color: root.palette.on-surface;
        font-size: Type.title-medium.size;
        font-family: Type.title-medium.family;
        font-weight: Type.title-medium.weight;
    }

    if (!root.cards) : sec-list := VerticalLayout {
        spacing: 2px;
        for item[i] in root.section.items : sec-row := M3ListItem {
            title: item.title;
            subtitle: item.subtitle;
            duration: item.duration;
            row-bg: root.palette.surface-container-low;
            active-bg: root.palette.secondary-container;
            title-color: root.palette.on-surface;
            subtitle-color: root.palette.on-surface-variant;
            accent: root.palette.primary;
            progress-track: root.palette.surface-container-highest;
            progress-fill: root.palette.primary;
            action => {
                if (item.playable) {
                    root.play-requested(item);
                } else {
                    root.detail-requested({ kind: item.kind, id: item.id });
                }
            }
        }
    }

    if (root.cards) : sec-rail := Flickable {
        height: 190px;

        sec-cards := HorizontalLayout {
            spacing: 12px;
            for item[i] in root.section.items : sec-card := M3Card {
                width: 150px;
                height: 190px;
                media: true;
                title: item.title;
                subtitle: item.subtitle;
                fill: root.palette.surface-container-low;
                art-fill: root.palette.surface-container-high;
                title-color: root.palette.on-surface;
                subtitle-color: root.palette.on-surface-variant;
                shadow-color: root.palette.shadow;
                clicked => {
                    if (item.playable) {
                        root.play-requested(item);
                    } else {
                        root.detail-requested({ kind: item.kind, id: item.id });
                    }
                }
            }
        }
    }
}
