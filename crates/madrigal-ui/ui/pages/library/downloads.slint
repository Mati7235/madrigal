import { Palette, Type } from "../../tokens.slint";
import { I18n } from "../../i18n.slint";
import { DownloadRow } from "models.slint";
import { Icon, Icons } from "../../components/icons.slint";

export component DownloadsPage inherits Rectangle {
    in property<Palette> palette;
    in property<[DownloadRow]> rows;
    in property<[DownloadRow]> failed;

    callback dl-pause(string);
    callback dl-resume(string);
    callback dl-cancel(string);
    callback dl-retry(string);
    callback dl-retry-all();

    background: root.palette.surface;
    accessible-role: text;
    accessible-label: I18n.trl(I18n.lang, "nav.downloads");

    VerticalLayout {
        spacing: 0px;

        dl-head := HorizontalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: center;

            dl-head-title := Text {
                text: I18n.trl(I18n.lang, "nav.downloads");
                color: root.palette.on-surface;
                font-size: Type.headline-small.size;
                font-weight: Type.headline-small.weight;
                horizontal-stretch: 1;
            }

            retry-all-wrap := Rectangle {
                height: 36px;
                width: 150px;
                border-radius: 18px;
                background: root.palette.surface-container-highest;
                visible: root.failed.length > 0;
                retry-all-label := Text {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    text: I18n.trl(I18n.lang, "common.retry");
                    color: root.palette.on-surface;
                    font-size: Type.label-large.size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                retry-all-touch := TouchArea {
                    accessible-label: I18n.trl(I18n.lang, "common.retry");
                    accessible-role: button;
                    mouse-cursor: pointer;
                    clicked => { root.dl-retry-all(); }
                }
            }
        }

        dl-body := Flickable {
            vertical-stretch: 1;
            content-height: dl-col.preferred-height;

            dl-col := VerticalLayout {
                width: 100%;
                spacing: 2px;
                padding: 8px;

                dl-empty := Text {
                    text: I18n.trl(I18n.lang, "downloads.empty");
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-medium.size;
                    horizontal-alignment: center;
                    visible: root.rows.length == 0 && root.failed.length == 0;
                }

                dl-active-label := Text {
                    text: I18n.trl(I18n.lang, "downloads.active");
                    color: root.palette.on-surface-variant;
                    font-size: Type.title-small.size;
                    visible: root.rows.length > 0;
                }

                for row in root.rows: Rectangle {
                    height: 72px;
                    border-radius: 12px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        alignment: center;

                        state-label := Icon {
                            width: 28px;
                            height: 18px;
                            source: row.state == 1 ? Icons.download : row.state == 2 ? Icons.pause : row.state == 3 ? Icons.check : row.state == 4 ? Icons.triangle-alert : row.state == 5 ? Icons.circle-x : Icons.loader-circle;
                            colorize: row.state == 4 || row.state == 5 ? root.palette.error : row.state == 3 ? root.palette.primary : root.palette.on-surface-variant;
                        }

                        dl-texts := VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;
                            dl-row-title := Text {
                                text: row.title;
                                color: root.palette.on-surface;
                                font-size: Type.body-large.size;
                                overflow: elide;
                            }
                            dl-sub := Text {
                                text: row.subtitle;
                                color: root.palette.on-surface-variant;
                                font-size: Type.body-medium.size;
                                overflow: elide;
                            }
                            dl-bar := Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: root.palette.surface-container-highest;
                                visible: row.state == 0 || row.state == 1;
                                dl-fill := Rectangle {
                                    width: parent.width * clamp(row.progress, 0, 1);
                                    height: 100%;
                                    border-radius: 2px;
                                    background: root.palette.primary;
                                }
                            }
                        }

                        dl-speed := Text {
                            text: row.speed;
                            color: root.palette.on-surface-variant;
                            font-size: Type.body-medium.size;
                            vertical-alignment: center;
                            visible: row.speed != "";
                        }

                        dl-pause-label := Icon {
                            width: 36px;
                            height: 18px;
                            source: Icons.pause;
                            colorize: root.palette.on-surface-variant;
                            visible: row.state == 0 || row.state == 1;
                        }
                        dl-pause-touch := TouchArea {
                            accessible-label: I18n.trl(I18n.lang, "action.pauseDownload");
                            accessible-role: button;
                            mouse-cursor: pointer;
                            enabled: row.state == 0 || row.state == 1;
                            clicked => { root.dl-pause(row.id); }
                        }

                        dl-resume-label := Icon {
                            width: 36px;
                            height: 18px;
                            source: Icons.play;
                            colorize: root.palette.primary;
                            visible: row.state == 2;
                        }
                        dl-resume-touch := TouchArea {
                            accessible-label: I18n.trl(I18n.lang, "action.resumeDownload");
                            accessible-role: button;
                            mouse-cursor: pointer;
                            enabled: row.state == 2;
                            clicked => { root.dl-resume(row.id); }
                        }

                        dl-cancel-label := Icon {
                            width: 36px;
                            height: 18px;
                            source: Icons.x;
                            colorize: root.palette.on-surface-variant;
                            visible: row.state != 3;
                        }
                        dl-cancel-touch := TouchArea {
                            accessible-label: I18n.trl(I18n.lang, "action.cancelDownload");
                            accessible-role: button;
                            mouse-cursor: pointer;
                            enabled: row.state != 3;
                            clicked => { root.dl-cancel(row.id); }
                        }
                    }
                }

                dl-failed-label := Text {
                    text: I18n.trl(I18n.lang, "downloads.failed");
                    color: root.palette.error;
                    font-size: Type.title-small.size;
                    visible: root.failed.length > 0;
                }

                for row in root.failed: Rectangle {
                    height: 64px;
                    border-radius: 12px;
                    background: transparent;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        alignment: center;

                        failed-state-label := Icon {
                            width: 28px;
                            height: 18px;
                            source: row.state == 1 ? Icons.download : row.state == 2 ? Icons.pause : row.state == 3 ? Icons.check : row.state == 4 ? Icons.triangle-alert : row.state == 5 ? Icons.circle-x : Icons.loader-circle;
                            colorize: root.palette.error;
                        }

                        failed-texts := VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            horizontal-stretch: 1;
                            failed-title := Text {
                                text: row.title;
                                color: root.palette.on-surface;
                                font-size: Type.body-large.size;
                                overflow: elide;
                            }
                            failed-sub := Text {
                                text: row.subtitle;
                                color: root.palette.error;
                                font-size: Type.body-medium.size;
                                overflow: elide;
                            }
                        }

                        dl-retry-label := Icon {
                            width: 36px;
                            height: 18px;
                            source: Icons.rotate-cw;
                            colorize: root.palette.primary;
                        }
                        dl-retry-touch := TouchArea {
                            accessible-label: I18n.trl(I18n.lang, "action.retryDownload");
                            accessible-role: button;
                            mouse-cursor: pointer;
                            clicked => { root.dl-retry(row.id); }
                        }
                    }
                }
            }
        }
    }
}
