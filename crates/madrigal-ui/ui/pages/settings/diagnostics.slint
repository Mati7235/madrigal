import { Palette, Type } from "../../tokens.slint";
import { I18n } from "../../i18n.slint";
import { M3Button } from "../../components/buttons.slint";
import { DiagLine } from "rows.slint";

export component DiagnosticsPanel inherits Rectangle {
    in property<Palette> palette;
    in property<[DiagLine]> entries;
    in property<int> entry-count;
    in-out property<int> level;
    in property<string> latency;
    in property<string> single;
    in property<string> export-status;
    in property<bool> exported;

    callback level-selected(int);
    callback export-pressed();

    background: root.palette.surface;

    diag-flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: diag-col.preferred-height;

        diag-col := VerticalLayout {
            width: 100%;
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 24px;
            spacing: 0px;

            diag-level-row := HorizontalLayout {
                height: 54px;
                spacing: 6px;

                diag-level-label := Text {
                    text: I18n.trl(I18n.lang, "settings.diag.level");
                    color: root.palette.on-surface-variant;
                    font-size: Type.label-large.size;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                diag-level-all := M3Button {
                    width: 110px;
                    text: I18n.trl(I18n.lang, "settings.diag.all");
                    fill: root.level == -1 ? root.palette.primary : root.palette.secondary-container;
                    content: root.level == -1 ? root.palette.on-primary : root.palette.on-secondary-container;
                    state-on-surface: root.palette.on-surface;
                    clicked => { root.level-selected(-1); }
                }

                diag-level-info := M3Button {
                    width: 110px;
                    text: I18n.trl(I18n.lang, "settings.diag.info");
                    fill: root.level == 0 ? root.palette.primary : root.palette.secondary-container;
                    content: root.level == 0 ? root.palette.on-primary : root.palette.on-secondary-container;
                    state-on-surface: root.palette.on-surface;
                    clicked => { root.level-selected(0); }
                }

                diag-level-warn := M3Button {
                    width: 110px;
                    text: I18n.trl(I18n.lang, "settings.diag.warn");
                    fill: root.level == 1 ? root.palette.primary : root.palette.secondary-container;
                    content: root.level == 1 ? root.palette.on-primary : root.palette.on-secondary-container;
                    state-on-surface: root.palette.on-surface;
                    clicked => { root.level-selected(1); }
                }

                diag-level-error := M3Button {
                    width: 110px;
                    text: I18n.trl(I18n.lang, "settings.diag.error");
                    fill: root.level == 2 ? root.palette.primary : root.palette.secondary-container;
                    content: root.level == 2 ? root.palette.on-primary : root.palette.on-secondary-container;
                    state-on-surface: root.palette.on-surface;
                    clicked => { root.level-selected(2); }
                }
            }

            diag-latency-frame := VerticalLayout {
                padding-top: 16px;

                diag-latency := Text {
                    text: I18n.trl(I18n.lang, "settings.diag.latency") + ": " + root.latency;
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-medium.size;
                    width: 100%;
                    wrap: word-wrap;
                }
            }

            diag-single-frame := VerticalLayout {
                padding-top: 8px;

                diag-single := Text {
                    text: I18n.trl(I18n.lang, root.single);
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-medium.size;
                    width: 100%;
                    wrap: word-wrap;
                }
            }

            diag-export-frame := HorizontalLayout {
                padding-top: 24px;
                alignment: start;

                diag-export-btn := M3Button {
                    width: 200px;
                    text: I18n.trl(I18n.lang, "settings.diag.export");
                    fill: root.palette.secondary-container;
                    content: root.palette.on-secondary-container;
                    state-on-surface: root.palette.on-surface;
                    clicked => { root.export-pressed(); }
                }
            }

            if (root.exported) : diag-exported-frame := VerticalLayout {
                padding-top: 12px;

                diag-exported := Text {
                    text: I18n.trl(I18n.lang, "settings.diag.exported") + ": " + root.export-status;
                    color: root.palette.primary;
                    font-size: Type.body-medium.size;
                    width: 100%;
                    wrap: word-wrap;
                }
            }

            if (root.entry-count == 0) : diag-empty-frame := VerticalLayout {
                padding-top: 24px;

                diag-empty := Text {
                    text: I18n.trl(I18n.lang, "settings.diag.empty");
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-medium.size;
                    width: 100%;
                }
            }

            diag-entries := VerticalLayout {
                padding-top: 24px;
                spacing: 4px;

                for entry in root.entries: diag-entry := Text {
                    text: entry.text;
                    color: entry.level == 2 ? root.palette.error : entry.level == 1 ? root.palette.primary : root.palette.on-surface-variant;
                    font-size: Type.body-small.size;
                    width: 100%;
                    wrap: word-wrap;
                }
            }
        }
    }
}
