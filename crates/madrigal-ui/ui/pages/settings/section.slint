import { Font, Palette, Type } from "../../tokens.slint";
import { I18n } from "../../i18n.slint";
import { M3Button, M3IconButton } from "../../components/buttons.slint";
import { M3Chip } from "../../components/cards.slint";
import { Icons } from "../../components/icons.slint";
import { M3TextField } from "../../components/fields.slint";
import { M3Switch, M3Slider } from "../../components/selection.slint";
import { SettingsRow } from "rows.slint";

export component SectionView inherits Rectangle {
    in property<Palette> palette;
    in property<int> group;
    in property<[SettingsRow]> rows;
    in property<string> test-result;
    in property<bool> po-done;
    in property<bool> po-ok;
    in property<bool> account-connected;
    in property<string> account-name;
    in property<string> account-email;
    in property<bool> account-busy;
    in property<string> account-error;
    in property<[string]> account-choices;
    in-out property<bool> advanced-open: false;
    in-out property<string> manual-cookie: "";

    callback setting-toggled(string, bool);
    callback setting-edited(string, string);
    callback setting-stepped(string, float);
    callback setting-chosen(string, string);
    callback setting-cycled(string);
    callback secret-toggled(string);
    callback provider-moved(string, int, float);
    callback provider-toggled(string, string, bool);
    callback test-connection(string);
    callback login-requested(string);

    background: root.palette.surface;

    property<bool> show-advanced: false;
    property<string> open-picker: "";
    property<bool> narrow: self.width < 760px;

    property<length> field-width: root.group == 7 ? min(420px, max(220px, self.width - 240px)) : min(360px, max(200px, self.width - 420px));
    property<length> secret-width: min(320px, max(160px, self.width - 460px));

    rows-flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: rows-col.preferred-height;

        rows-col := VerticalLayout {
            width: 100%;
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 96px;
            spacing: 0px;

            rows-block := VerticalLayout {
                width: 100%;
                spacing: 0px;

                for row[i] in root.rows: row-block := VerticalLayout {
                    width: 100%;
                    spacing: 0px;

                    if (!row.hidden && row.section != "") : sec-head := VerticalLayout {
                        padding-top: i == 0 ? 8px : 24px;
                        spacing: 4px;

                        sec-title := Text {
                            text: I18n.trl(I18n.lang, row.section);
                            color: root.palette.primary;
                            font-size: Type.title-small.size;
                            font-family: Type.title-small.family;
                            font-weight: Type.title-small.weight;
                            height: 24px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if (row.advanced) : sec-toggle := M3Button {
                            width: 260px;
                            text: root.show-advanced ? I18n.trl(I18n.lang, "settings.hideAdvanced") : I18n.trl(I18n.lang, "settings.showAdvanced");
                            fill: root.palette.secondary-container;
                            content: root.palette.on-secondary-container;
                            state-on-surface: root.palette.on-surface;
                            clicked => { root.show-advanced = !root.show-advanced; }
                        }
                    }

                    if (!row.hidden && (!row.advanced || root.show-advanced) && row.kind == "providers") : prov-col := VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;

                        prov-label := Text {
                            text: I18n.trl(I18n.lang, row.label);
                            color: root.palette.on-surface;
                            font-size: Type.body-medium.size;
                            font-family: Font.title;
                            font-weight: Type.label-large.weight;
                        }

                        prov-list := VerticalLayout {
                            spacing: 4px;

                            for prov[j] in row.options: prov-row := Rectangle {
                                height: 54px;
                                background: root.palette.surface-container;
                                border-radius: 8px;

                                prov-drag := TouchArea {
                                    property<length> press-y: 0px;
                                    property<bool> committed: false;
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: grab;
                                    moved => {
                                        if (self.pressed && !self.committed) {
                                            if (self.mouse-y - self.press-y > 4px) {
                                                self.committed = true;
                                                root.provider-moved(row.key, j, 52.0);
                                            } else if (self.press-y - self.mouse-y > 4px) {
                                                self.committed = true;
                                                root.provider-moved(row.key, j, -52.0);
                                            }
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            self.committed = false;
                                            self.press-y = self.mouse-y;
                                        }
                                        if (e.kind == PointerEventKind.up) {
                                            self.committed = false;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 8px;

                                    prov-toggle-frame := Rectangle {
                                        width: 52px;

                                        VerticalLayout {
                                            alignment: center;

                                            prov-toggle := M3Switch {
                                                label: prov;
                                                checked: row.flags[j] == "1";
                                                on-track: root.palette.primary;
                                                on-thumb: root.palette.on-primary;
                                                off-track: root.palette.surface-container-highest;
                                                off-line: root.palette.outline-variant;
                                                off-thumb: root.palette.outline-variant;
                                                state-on-surface: root.palette.on-surface;
                                                toggled(v) => { root.provider-toggled(row.key, prov, v); }
                                            }
                                        }
                                    }

                                    prov-name := Text {
                                        text: I18n.trl(I18n.lang, "lyrics.provider." + prov);
                                        color: root.palette.on-surface;
                                        font-size: Type.body-medium.size;
                                        font-family: Type.body-medium.family;
                                        height: 100%;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    prov-up-frame := Rectangle {
                                        width: 40px;

                                        VerticalLayout {
                                            alignment: center;

                                            prov-up := M3IconButton {
                                                icon: Icons.chevron-up;
                                                icon-color: root.palette.on-surface-variant;
                                                content: root.palette.on-surface-variant;
                                                state-on-surface: root.palette.on-surface;
                                                clicked => { root.provider-moved(row.key, j, -52.0); }
                                            }
                                        }
                                    }

                                    prov-down-frame := Rectangle {
                                        width: 40px;

                                        VerticalLayout {
                                            alignment: center;

                                            prov-down := M3IconButton {
                                                icon: Icons.chevron-down;
                                                icon-color: root.palette.on-surface-variant;
                                                content: root.palette.on-surface-variant;
                                                state-on-surface: root.palette.on-surface;
                                                clicked => { root.provider-moved(row.key, j, 52.0); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if (!row.hidden && (!row.advanced || root.show-advanced) && row.kind != "providers") : row-frame := Rectangle {
                        height: root.group == 7 ? 54px : 56px;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 16px;

                            label-frame := Rectangle {
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 0px;

                                    row-label := Text {
                                        text: I18n.trl(I18n.lang, row.label);
                                        color: root.palette.on-surface;
                                        font-size: Type.body-medium.size;
                                        font-family: Font.title;
                                        font-weight: Type.label-large.weight;
                                        width: 100%;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    row-hint := Text {
                                        visible: row.hint != "";
                                        text: I18n.trl(I18n.lang, row.hint);
                                        color: root.palette.on-surface-variant;
                                        font-size: Type.body-small.size;
                                        font-family: Type.body-small.family;
                                        width: 100%;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if (row.kind == "switch") : switch-frame := Rectangle {
                                width: 52px;

                                VerticalLayout {
                                    alignment: center;

                                    row-toggle := M3Switch {
                                        label: I18n.trl(I18n.lang, row.label);
                                        checked: row.val-bool;
                                        on-track: root.palette.primary;
                                        on-thumb: root.palette.on-primary;
                                        off-track: root.palette.surface-container-highest;
                                        off-line: root.palette.outline-variant;
                                        off-thumb: root.palette.outline-variant;
                                        state-on-surface: root.palette.on-surface;
                                        toggled(v) => { root.setting-toggled(row.key, v); }
                                    }
                                }
                            }

                            if (row.kind == "text") : field-frame := Rectangle {
                                width: root.field-width;

                                VerticalLayout {
                                    alignment: center;

                                    row-field := M3TextField {
                                        width: 100%;
                                        dense: true;
                                        label: I18n.trl(I18n.lang, row.label);
                                        text: row.display;
                                        placeholder: I18n.trl(I18n.lang, row.placeholder);
                                        field-bg: root.palette.surface-container-highest;
                                        line: root.palette.outline-variant;
                                        focus-line: root.palette.primary;
                                        content: root.palette.on-surface;
                                        support-color: root.palette.on-surface-variant;
                                        state-on-surface: root.palette.on-surface;
                                        accepted(t) => { root.setting-edited(row.key, t); }
                                    }
                                }
                            }

                            if (row.kind == "slider") : slider-frame := Rectangle {
                                width: root.narrow ? 288px : 352px;

                                VerticalLayout {
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: end;

                                        VerticalLayout {
                                            alignment: center;

                                            slider-shift := Rectangle {
                                                width: root.narrow ? 196px : 252px;
                                                height: 44px;

                                                row-slider := M3Slider {
                                                    x: -16px;
                                                    width: root.narrow ? 228px : 284px;
                                                    height: 44px;
                                                    show-value: false;
                                                    label: I18n.trl(I18n.lang, row.label);
                                                    value: (row.val-num - row.val-min) / (row.val-max - row.val-min);
                                                    active-track: root.palette.primary;
                                                    inactive-track: root.palette.surface-container-highest;
                                                    handle-color: root.palette.primary;
                                                    state-on-surface: root.palette.on-surface;
                                                    changed(v) => { root.setting-stepped(row.key, row.val-min + v * (row.val-max - row.val-min)); }
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;

                                            slider-value := Text {
                                                width: root.narrow ? 72px : 88px;
                                                height: 24px;
                                                text: row.val-label;
                                                color: root.palette.on-surface;
                                                font-size: Type.label-large.size;
                                                font-family: Type.label-large.family;
                                                font-weight: Type.label-large.weight;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }

                            if (row.kind == "choice" && row.options.length <= 4 && !root.narrow && root.group != 7) : choice-frame := Rectangle {
                                horizontal-stretch: 0;

                                VerticalLayout {
                                    alignment: center;

                                    choice-cluster := HorizontalLayout {
                                        spacing: 6px;

                                        for opt[k] in row.options: row-option := M3Chip {
                                            text: I18n.trl(I18n.lang, row.option-labels[k]);
                                            selected: opt == row.val-text;
                                            selected-fill: root.palette.primary;
                                            selected-content: root.palette.on-primary;
                                            unselected-content: root.palette.on-surface-variant;
                                            unselected-line: root.palette.outline-variant;
                                            clicked => { root.setting-chosen(row.key, opt); }
                                        }
                                    }
                                }
                            }

                            if (row.kind == "choice" && (row.options.length > 4 || root.narrow) && root.group != 7) : picker-frame := Rectangle {
                                width: 220px;

                                VerticalLayout {
                                    alignment: center;

                                    row-picker := M3Button {
                                        width: 100%;
                                        text: I18n.trl(I18n.lang, row.val-label);
                                        fill: root.palette.secondary-container;
                                        content: root.palette.on-secondary-container;
                                        state-on-surface: root.palette.on-surface;
                                        clicked => { root.open-picker = root.open-picker == row.key ? "" : row.key; }
                                    }
                                }
                            }

                            if (row.kind == "apikey") : apikey-frame := Rectangle {
                                horizontal-stretch: 0;

                                VerticalLayout {
                                    alignment: center;

                                    apikey-col := HorizontalLayout {
                                        spacing: 8px;

                                        if (!row.secret) : apikey-masked := Text {
                                            text: row.display;
                                            color: root.palette.on-surface-variant;
                                            font-size: Type.body-medium.size;
                                            font-family: Type.body-medium.family;
                                            width: root.secret-width;
                                            height: 100%;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        if (row.secret) : row-secret-field := M3TextField {
                                            width: root.secret-width;
                                            dense: true;
                                            label: I18n.trl(I18n.lang, row.label);
                                            text: row.display;
                                            placeholder: I18n.trl(I18n.lang, row.placeholder);
                                            field-bg: root.palette.surface-container-highest;
                                            line: root.palette.outline-variant;
                                            focus-line: root.palette.primary;
                                            content: root.palette.on-surface;
                                            support-color: root.palette.on-surface-variant;
                                            state-on-surface: root.palette.on-surface;
                                            accepted(t) => { root.setting-edited(row.key, t); }
                                        }

                                        row-reveal := M3Button {
                                            width: 112px;
                                            text: row.secret ? I18n.trl(I18n.lang, "settings.hideSecret") : I18n.trl(I18n.lang, "settings.showSecret");
                                            fill: root.palette.secondary-container;
                                            content: root.palette.on-secondary-container;
                                            state-on-surface: root.palette.on-surface;
                                            clicked => { root.secret-toggled(row.key); }
                                        }
                                    }
                                }
                            }

                            if (row.test != "") : test-frame := Rectangle {
                                width: 168px;

                                VerticalLayout {
                                    alignment: center;

                                    row-test := M3Button {
                                        width: 100%;
                                        text: I18n.trl(I18n.lang, "settings.malojaTest");
                                        fill: root.palette.secondary-container;
                                        content: root.palette.on-secondary-container;
                                        state-on-surface: root.palette.on-surface;
                                        clicked => { root.test-connection(row.test); }
                                    }
                                }
                            }
                        }
                    }

                    if (!row.hidden && (!row.advanced || root.show-advanced) && row.kind == "choice" && (row.options.length > 4 || root.narrow) && root.group != 7 && root.open-picker == row.key) : picker-list := VerticalLayout {
                        padding-bottom: 8px;
                        spacing: 2px;

                        for opt[k] in row.options: picker-option := Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: opt == row.val-text ? root.palette.secondary-container : transparent;
                            accessible-role: AccessibleRole.button;
                            accessible-label: I18n.trl(I18n.lang, row.option-labels[k]);

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;

                                Text {
                                    text: I18n.trl(I18n.lang, row.option-labels[k]);
                                    color: opt == row.val-text ? root.palette.on-secondary-container : root.palette.on-surface;
                                    font-size: Type.body-medium.size;
                                    font-family: Type.body-medium.family;
                                    font-weight: opt == row.val-text ? Type.label-large.weight : Type.body-medium.weight;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            picker-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.setting-chosen(row.key, opt);
                                    root.open-picker = "";
                                }
                            }
                        }
                    }
                }
            }

            if (root.group == 3) : lyrics-help := VerticalLayout {
                padding-top: 24px;
                spacing: 8px;

                lyrics-help-text := Text {
                    text: I18n.trl(I18n.lang, "settings.lyricsProvidersHelp");
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-small.size;
                    font-family: Type.body-small.family;
                    width: 100%;
                    wrap: word-wrap;
                }

                lyrics-note-text := Text {
                    text: I18n.trl(I18n.lang, "settings.lyricsYoutubeNote");
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-small.size;
                    font-family: Type.body-small.family;
                    width: 100%;
                    wrap: word-wrap;
                }
            }

            if (root.group == 4 && root.po-done) : po-status-frame := VerticalLayout {
                padding-top: 24px;

                po-status := Text {
                    text: root.po-ok ? I18n.trl(I18n.lang, "settings.potOk") : I18n.trl(I18n.lang, "settings.potMissing");
                    color: root.po-ok ? root.palette.primary : root.palette.error;
                    font-size: Type.body-medium.size;
                    font-family: Type.body-medium.family;
                    width: 100%;
                    wrap: word-wrap;
                }
            }

            if (root.group == 7) : account-block := VerticalLayout {
                padding-top: 24px;
                spacing: 8px;

                acct-status := Text {
                    text: root.account-connected ? (root.account-name != "" ? I18n.trl(I18n.lang, "settings.accountConnectedAs") + root.account-name : I18n.trl(I18n.lang, "settings.accountConnected")) : I18n.trl(I18n.lang, "settings.accountDisconnected");
                    color: root.account-connected ? root.palette.primary : root.palette.on-surface-variant;
                    font-size: Type.body-medium.size;
                    font-family: Type.body-medium.family;
                    font-weight: root.account-connected ? Type.label-large.weight : Type.label-large.weight;
                    width: 100%;
                    wrap: word-wrap;
                }

                if (root.account-connected && root.account-email != "") : acct-email := Text {
                    text: root.account-email;
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-small.size;
                    font-family: Type.body-small.family;
                    width: 100%;
                    wrap: word-wrap;
                }

                acct-help := Text {
                    text: I18n.trl(I18n.lang, "settings.accountHelp");
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-small.size;
                    font-family: Type.body-small.family;
                    width: 100%;
                    wrap: word-wrap;
                }

                if (root.account-busy) : acct-busy := Text {
                    text: I18n.trl(I18n.lang, "settings.accountBusy");
                    color: root.palette.on-surface;
                    font-size: Type.body-medium.size;
                    font-family: Type.body-medium.family;
                    width: 100%;
                    wrap: word-wrap;
                }

                if (root.account-error != "") : acct-error := Text {
                    text: I18n.trl(I18n.lang, root.account-error);
                    color: root.palette.error;
                    font-size: Type.body-small.size;
                    font-family: Type.body-small.family;
                    width: 100%;
                    wrap: word-wrap;
                }

                account-actions := HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    if (!root.account-connected) : acct-connect := M3Button {
                        width: 220px;
                        text: I18n.trl(I18n.lang, "settings.accountConnect");
                        enabled: !root.account-busy;
                        fill: root.palette.primary;
                        content: root.palette.on-primary;
                        state-on-surface: root.palette.on-surface;
                        clicked => { root.login-requested("browser"); }
                    }

                    if (!root.account-connected) : acct-advanced := M3Button {
                        width: 140px;
                        text: I18n.trl(I18n.lang, "settings.advanced");
                        enabled: !root.account-busy;
                        fill: root.palette.secondary-container;
                        content: root.palette.on-secondary-container;
                        state-on-surface: root.palette.on-surface;
                        clicked => { root.advanced-open = !root.advanced-open; }
                    }

                    if (root.account-connected) : acct-signout := M3Button {
                        width: 180px;
                        text: I18n.trl(I18n.lang, "settings.signOut");
                        enabled: !root.account-busy;
                        fill: root.palette.secondary-container;
                        content: root.palette.on-secondary-container;
                        state-on-surface: root.palette.on-surface;
                        clicked => { root.login-requested("signout"); }
                    }
                }

                if (!root.account-connected && root.account-choices.length > 0) : acct-choose := VerticalLayout {
                    spacing: 4px;

                    acct-choose-label := Text {
                        text: I18n.trl(I18n.lang, "settings.chooseBrowser");
                        color: root.palette.on-surface-variant;
                        font-size: Type.body-small.size;
                        font-family: Type.body-small.family;
                        width: 100%;
                        wrap: word-wrap;
                    }

                    for choice[i] in root.account-choices : acct-choice := M3Button {
                        width: 220px;
                        text: choice;
                        enabled: !root.account-busy;
                        fill: root.palette.surface-container;
                        content: root.palette.on-surface;
                        state-on-surface: root.palette.on-surface;
                        clicked => { root.login-requested(choice); }
                    }
                }

                if (!root.account-connected && root.advanced-open) : acct-advanced-box := VerticalLayout {
                    spacing: 8px;

                    acct-advanced-help := Text {
                        text: I18n.trl(I18n.lang, "settings.manualCookieHelp");
                        color: root.palette.on-surface-variant;
                        font-size: Type.body-small.size;
                        font-family: Type.body-small.family;
                        width: 100%;
                        wrap: word-wrap;
                    }

                    acct-manual := M3TextField {
                        width: root.field-width;
                        height: 56px;
                        label: I18n.trl(I18n.lang, "settings.manualCookie");
                        text <=> root.manual-cookie;
                        placeholder: I18n.trl(I18n.lang, "settings.ph.manualCookie");
                        enabled: !root.account-busy;
                        field-bg: root.palette.surface-container;
                        line: root.palette.outline-variant;
                        focus-line: root.palette.primary;
                        content: root.palette.on-surface;
                        support-color: root.palette.on-surface-variant;
                        state-on-surface: root.palette.on-surface;
                    }

                    acct-manual-apply := M3Button {
                        width: 180px;
                        text: I18n.trl(I18n.lang, "settings.manualCookieApply");
                        enabled: !root.account-busy && root.manual-cookie != "";
                        fill: root.palette.primary;
                        content: root.palette.on-primary;
                        state-on-surface: root.palette.on-surface;
                        clicked => {
                            root.login-requested("manual:" + root.manual-cookie);
                            root.manual-cookie = "";
                        }
                    }
                }
            }

            if (root.test-result != "") : test-result-frame := VerticalLayout {
                padding-top: 24px;

                test-result-text := Text {
                    text: I18n.trl(I18n.lang, root.test-result);
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-medium.size;
                    font-family: Type.body-medium.family;
                    width: 100%;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component AppearanceSection inherits Rectangle {
    in property<Palette> palette;
    in property<[SettingsRow]> rows;
    in property<string> test-result;
    in property<bool> po-done;
    in property<bool> po-ok;
    callback setting-toggled(string, bool);
    callback setting-edited(string, string);
    callback setting-stepped(string, float);
    callback setting-chosen(string, string);
    callback setting-cycled(string);
    callback secret-toggled(string);
    callback provider-moved(string, int, float);
    callback provider-toggled(string, string, bool);
    callback test-connection(string);
    callback login-requested(string);

    SectionView {
