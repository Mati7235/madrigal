import { Font, Palette, Type } from "../../tokens.slint";
import { I18n } from "../../i18n.slint";
import { M3Button, M3IconButton } from "../../components/buttons.slint";
import { M3Chip } from "../../components/cards.slint";
import { Icons } from "../../components/icons.slint";
import { M3TextField } from "../../components/fields.slint";
import { M3Switch, M3Slider } from "../../components/selection.slint";
import { SettingsRow } from "rows.slint";

export component SectionView inherits Rectangle {
    in property<Palette> palette;
    in property<int> group;
    in property<[SettingsRow]> rows;
    in property<string> test-result;
    in property<bool> po-done;
    in property<bool> po-ok;

    callback setting-toggled(string, bool);
    callback setting-edited(string, string);
    callback setting-stepped(string, float);
    callback setting-chosen(string, string);
    callback setting-cycled(string);
    callback secret-toggled(string);
    callback provider-moved(string, int, float);
    callback provider-toggled(string, string, bool);
    callback test-connection(string);
    callback login-requested(string);

    background: root.palette.surface;

    property<length> field-width: 420px;
    property<length> secret-width: 320px;

    rows-flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: rows-col.preferred-height;

        rows-col := VerticalLayout {
            width: 100%;
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 24px;
            spacing: 0px;

            rows-block := VerticalLayout {
                width: 100%;
                spacing: 0px;

                for row[i] in root.rows: row-block := VerticalLayout {
                    width: 100%;
                    spacing: 0px;

                    if (row.kind == "providers") : prov-col := VerticalLayout {
                        padding-top: 24px;
                        padding-bottom: 24px;
                        spacing: 8px;

                        prov-label := Text {
                            text: I18n.trl(I18n.lang, row.label);
                            color: root.palette.on-surface;
                            font-size: Type.body-medium.size;
                            font-family: Font.title;
                            font-weight: Type.label-large.weight;
                        }

                        prov-list := VerticalLayout {
                            spacing: 4px;

                            for prov[j] in row.options: prov-row := Rectangle {
                                height: 54px;
                                background: root.palette.surface-container;
                                border-radius: 8px;

                                prov-drag := TouchArea {
                                    property<length> press-y: 0px;
                                    property<bool> committed: false;
                                    width: 100%;
                                    height: 100%;
                                    mouse-cursor: grab;
                                    moved => {
                                        if (self.pressed && !self.committed) {
                                            if (self.mouse-y - self.press-y > 4px) {
                                                self.committed = true;
                                                root.provider-moved(row.key, j, 52.0);
                                            } else if (self.press-y - self.mouse-y > 4px) {
                                                self.committed = true;
                                                root.provider-moved(row.key, j, -52.0);
                                            }
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            self.committed = false;
                                            self.press-y = self.mouse-y;
                                        }
                                        if (e.kind == PointerEventKind.up) {
                                            self.committed = false;
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 8px;

                                    prov-toggle-frame := Rectangle {
                                        width: 52px;

                                        VerticalLayout {
                                            alignment: center;

                                            prov-toggle := M3Switch {
                                                label: prov;
                                                checked: row.flags[j] == "1";
                                                on-track: root.palette.primary;
                                                on-thumb: root.palette.on-primary;
                                                off-track: root.palette.surface-container-highest;
                                                off-line: root.palette.outline-variant;
                                                off-thumb: root.palette.outline-variant;
                                                state-on-surface: root.palette.on-surface;
                                                toggled(v) => { root.provider-toggled(row.key, prov, v); }
                                            }
                                        }
                                    }

                                    prov-name := Text {
                                        text: I18n.trl(I18n.lang, "lyrics.provider." + prov);
                                        color: root.palette.on-surface;
                                        font-size: Type.body-medium.size;
                                        font-family: Type.body-medium.family;
                                        height: 100%;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    prov-up-frame := Rectangle {
                                        width: 40px;

                                        VerticalLayout {
                                            alignment: center;

                                            prov-up := M3IconButton {
                                                icon: Icons.chevron-up;
                                                icon-color: root.palette.on-surface-variant;
                                                content: root.palette.on-surface-variant;
                                                state-on-surface: root.palette.on-surface;
                                                clicked => { root.provider-moved(row.key, j, -52.0); }
                                            }
                                        }
                                    }

                                    prov-down-frame := Rectangle {
                                        width: 40px;

                                        VerticalLayout {
                                            alignment: center;

                                            prov-down := M3IconButton {
                                                icon: Icons.chevron-down;
                                                icon-color: root.palette.on-surface-variant;
                                                content: root.palette.on-surface-variant;
                                                state-on-surface: root.palette.on-surface;
                                                clicked => { root.provider-moved(row.key, j, 52.0); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if (row.kind != "providers") : row-frame := Rectangle {
                        height: 54px;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 16px;

                            label-frame := Rectangle {
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    alignment: center;

                                    row-label := Text {
                                        text: I18n.trl(I18n.lang, row.label);
                                        color: root.palette.on-surface;
                                        font-size: Type.body-medium.size;
                                        font-family: Font.title;
                                        font-weight: Type.label-large.weight;
                                        width: 100%;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            if (row.kind == "switch") : switch-frame := Rectangle {
                                width: 52px;

                                VerticalLayout {
                                    alignment: center;

                                    row-toggle := M3Switch {
                                        label: I18n.trl(I18n.lang, row.label);
                                        checked: row.val-bool;
                                        on-track: root.palette.primary;
                                        on-thumb: root.palette.on-primary;
                                        off-track: root.palette.surface-container-highest;
                                        off-line: root.palette.outline-variant;
                                        off-thumb: root.palette.outline-variant;
                                        state-on-surface: root.palette.on-surface;
                                        toggled(v) => { root.setting-toggled(row.key, v); }
                                    }
                                }
                            }

                            if (row.kind == "text") : field-frame := Rectangle {
                                width: root.field-width;

                                VerticalLayout {
                                    alignment: center;

                                    row-field := M3TextField {
                                        width: 100%;
                                        dense: true;
                                        label: I18n.trl(I18n.lang, row.label);
                                        text: row.display;
                                        field-bg: root.palette.surface-container-highest;
                                        line: root.palette.outline-variant;
                                        focus-line: root.palette.primary;
                                        content: root.palette.on-surface;
                                        support-color: root.palette.on-surface-variant;
                                        state-on-surface: root.palette.on-surface;
                                        accepted(t) => { root.setting-edited(row.key, t); }
                                    }
                                }
                            }

                            if (row.kind == "slider") : slider-frame := Rectangle {
                                width: 280px;

                                VerticalLayout {
                                    alignment: center;

                                    slider-shift := Rectangle {
                                        width: 280px;
                                        height: 44px;

                                        row-slider := M3Slider {
                                            x: -16px;
                                            width: 312px;
                                            height: 44px;
                                            label: I18n.trl(I18n.lang, row.label);
                                            value: (row.val-num - row.val-min) / (row.val-max - row.val-min);
                                            active-track: root.palette.primary;
                                            inactive-track: root.palette.surface-container-highest;
                                            handle-color: root.palette.primary;
                                            state-on-surface: root.palette.on-surface;
                                            changed(v) => { root.setting-stepped(row.key, row.val-min + v * (row.val-max - row.val-min)); }
                                        }
                                    }
                                }
                            }

                            if (row.kind == "choice") : choice-frame := Rectangle {
                                horizontal-stretch: 0;

                                VerticalLayout {
                                    alignment: center;

                                    choice-cluster := HorizontalLayout {
                                        spacing: 6px;

                                        for opt in row.options: row-option := M3Chip {
                                            text: opt == "" ? I18n.trl(I18n.lang, "settings.none") : opt;
                                            selected: opt == row.val-text;
                                            selected-fill: root.palette.primary;
                                            selected-content: root.palette.on-primary;
                                            unselected-content: root.palette.on-surface-variant;
                                            unselected-line: root.palette.outline-variant;
                                            clicked => { root.setting-chosen(row.key, opt); }
                                        }

                                        row-choice-cycle := M3IconButton {
                                            accessible-label: I18n.trl(I18n.lang, row.label);
                                            icon: Icons.chevron-right;
                                            icon-color: root.palette.on-surface-variant;
                                            content: root.palette.on-surface-variant;
                                            state-on-surface: root.palette.on-surface;
                                            clicked => { root.setting-cycled(row.key); }
                                        }
                                    }
                                }
                            }

                            if (row.kind == "apikey") : apikey-frame := Rectangle {
                                horizontal-stretch: 0;

                                VerticalLayout {
                                    alignment: center;

                                    apikey-col := HorizontalLayout {
                                        spacing: 8px;

                                        if (!row.secret) : apikey-masked := Text {
                                            text: row.display;
                                            color: root.palette.on-surface-variant;
                                            font-size: Type.body-medium.size;
                                            font-family: Type.body-medium.family;
                                            width: root.secret-width;
                                            height: 100%;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        if (row.secret) : row-secret-field := M3TextField {
                                            width: root.secret-width;
                                            dense: true;
                                            label: I18n.trl(I18n.lang, row.label);
                                            text: row.display;
                                            field-bg: root.palette.surface-container-highest;
                                            line: root.palette.outline-variant;
                                            focus-line: root.palette.primary;
                                            content: root.palette.on-surface;
                                            support-color: root.palette.on-surface-variant;
                                            state-on-surface: root.palette.on-surface;
                                            accepted(t) => { root.setting-edited(row.key, t); }
                                        }

                                        row-reveal := M3Button {
                                            width: 112px;
                                            text: row.secret ? I18n.trl(I18n.lang, "settings.hideSecret") : I18n.trl(I18n.lang, "settings.showSecret");
                                            fill: root.palette.secondary-container;
                                            content: root.palette.on-secondary-container;
                                            state-on-surface: root.palette.on-surface;
                                            clicked => { root.secret-toggled(row.key); }
                                        }
                                    }
                                }
                            }

                            if (row.test != "") : test-frame := Rectangle {
                                width: 168px;

                                VerticalLayout {
                                    alignment: center;

                                    row-test := M3Button {
                                        width: 100%;
                                        text: I18n.trl(I18n.lang, "settings.malojaTest");
                                        fill: root.palette.secondary-container;
                                        content: root.palette.on-secondary-container;
                                        state-on-surface: root.palette.on-surface;
                                        clicked => { root.test-connection(row.test); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if (root.group == 3) : lyrics-help := VerticalLayout {
                padding-top: 24px;
                spacing: 8px;

                lyrics-help-text := Text {
                    text: I18n.trl(I18n.lang, "settings.lyricsProvidersHelp");
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-small.size;
                    font-family: Type.body-small.family;
                    width: 100%;
                    wrap: word-wrap;
                }

                lyrics-note-text := Text {
                    text: I18n.trl(I18n.lang, "settings.lyricsYoutubeNote");
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-small.size;
                    font-family: Type.body-small.family;
                    width: 100%;
                    wrap: word-wrap;
                }
            }

            if (root.group == 4 && root.po-done) : po-status-frame := VerticalLayout {
                padding-top: 24px;

                po-status := Text {
                    text: root.po-ok ? I18n.trl(I18n.lang, "settings.potOk") : I18n.trl(I18n.lang, "settings.potMissing");
                    color: root.po-ok ? root.palette.primary : root.palette.error;
                    font-size: Type.body-medium.size;
                    font-family: Type.body-medium.family;
                    width: 100%;
                    wrap: word-wrap;
                }
            }

            if (root.group == 7) : account-actions := HorizontalLayout {
                padding-top: 24px;
                spacing: 8px;
                alignment: start;

                acct-signin := M3Button {
                    width: 180px;
                    text: I18n.trl(I18n.lang, "settings.signIn");
                    fill: root.palette.primary;
                    content: root.palette.on-primary;
                    state-on-surface: root.palette.on-surface;
                    clicked => { root.login-requested("google"); }
                }

                acct-signout := M3Button {
                    width: 180px;
                    text: I18n.trl(I18n.lang, "settings.signOut");
                    fill: root.palette.secondary-container;
                    content: root.palette.on-secondary-container;
                    state-on-surface: root.palette.on-surface;
                    clicked => { root.login-requested("signout"); }
                }
            }

            if (root.test-result != "") : test-result-frame := VerticalLayout {
                padding-top: 24px;

                test-result-text := Text {
                    text: root.test-result;
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-medium.size;
                    font-family: Type.body-medium.family;
                    width: 100%;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component AppearanceSection inherits Rectangle {
    in property<Palette> palette;
    in property<[SettingsRow]> rows;
    in property<string> test-result;
    in property<bool> po-done;
    in property<bool> po-ok;
    callback setting-toggled(string, bool);
    callback setting-edited(string, string);
    callback setting-stepped(string, float);
    callback setting-chosen(string, string);
    callback setting-cycled(string);
    callback secret-toggled(string);
    callback provider-moved(string, int, float);
    callback provider-toggled(string, string, bool);
    callback test-connection(string);
    callback login-requested(string);

    SectionView {
        width: 100%;
        height: 100%;
        palette: root.palette;
        group: 0;
        rows: root.rows;
        test-result: root.test-result;
        po-done: root.po-done;
        po-ok: root.po-ok;
        setting-toggled(k, v) => { root.setting-toggled(k, v); }
        setting-edited(k, v) => { root.setting-edited(k, v); }
        setting-stepped(k, v) => { root.setting-stepped(k, v); }
        setting-chosen(k, v) => { root.setting-chosen(k, v); }
        setting-cycled(k) => { root.setting-cycled(k); }
        secret-toggled(k) => { root.secret-toggled(k); }
        provider-moved(k, f, d) => { root.provider-moved(k, f, d); }
        provider-toggled(k, p, v) => { root.provider-toggled(k, p, v); }
        test-connection(t) => { root.test-connection(t); }
        login-requested(l) => { root.login-requested(l); }
    }
}

