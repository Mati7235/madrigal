import { Palette, Type } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { M3IconButton } from "../components/buttons.slint";

export component NowPlayingBar inherits Rectangle {
    in property<Palette> palette;
    in property<string> title;
    in property<string> artist;
    in property<bool> has-track: false;
    in property<int> position-ms: 0;
    in property<int> duration-ms: 0;
    in property<bool> paused: true;
    in property<bool> liked: false;
    in property<int> queue-count: 0;

    callback play-clicked();
    callback prev-clicked();
    callback next-clicked();
    callback like-clicked();
    callback queue-clicked();

    accessible-role: AccessibleRole.content-info;
    accessible-label: I18n.trl(I18n.lang, "player.nowPlaying");

    property<float> frac: root.duration-ms > 0 ? (1.0 * root.position-ms) / root.duration-ms : 0;

    bar-thumb := Rectangle {
        x: 12px;
        y: 14px;
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: root.palette.secondary-container;

        bar-initial := Text {
            text: root.has-track ? root.title : "?";
            color: root.palette.on-secondary-container;
            font-size: Type.title-large.size;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
            overflow: clip;
        }
    }

    bar-texts := VerticalLayout {
        x: 64px;
        y: 12px;
        width: 220px;
        height: 40px;
        spacing: 0px;

        bar-title := Text {
            text: root.has-track ? root.title : I18n.trl(I18n.lang, "player.noTrack");
            color: root.palette.on-surface;
            font-size: Type.body-large.size;
            overflow: elide;
        }

        bar-sub := Text {
            text: root.has-track ? root.artist + " · " + root.queue-count : "";
            color: root.palette.on-surface-variant;
            font-size: Type.body-medium.size;
            overflow: elide;
        }
    }

    bar-progress := Rectangle {
        x: 64px;
        y: 58px;
        width: 220px;
        height: 4px;
        border-radius: 2px;
        background: root.palette.surface-container-highest;

        bar-fill := Rectangle {
            width: parent.width * clamp(root.frac, 0, 1);
            height: 100%;
            border-radius: 2px;
            background: root.palette.primary;
        }
    }

    bar-transport := HorizontalLayout {
        x: 300px;
        y: 0px;
        width: 150px;
        height: 100%;
        spacing: 0px;
        alignment: center;

        bar-prev := M3IconButton {
            glyph: "|<";
            content: root.palette.on-surface-variant;
            state-on-surface: root.palette.on-surface;
            clicked => { root.prev-clicked(); }
        }

        bar-play := M3IconButton {
            glyph: root.paused ? ">" : "||";
            selected: !root.paused;
            fill: root.palette.primary;
            content: root.paused ? root.palette.on-surface-variant : root.palette.on-primary;
            state-on-surface: root.palette.on-surface;
            clicked => { root.play-clicked(); }
        }

        bar-next := M3IconButton {
            glyph: ">|";
            content: root.palette.on-surface-variant;
            state-on-surface: root.palette.on-surface;
            clicked => { root.next-clicked(); }
        }
    }

    bar-like := M3IconButton {
        x: 456px;
        y: 16px;
        glyph: root.liked ? "<3" : "o";
        selected: root.liked;
        fill: root.liked ? root.palette.primary : transparent;
        content: root.liked ? root.palette.on-primary : root.palette.on-surface-variant;
        state-on-surface: root.palette.on-surface;
        clicked => { root.like-clicked(); }
    }

    bar-queue := M3IconButton {
        x: 504px;
        y: 16px;
        glyph: "=";
        content: root.palette.on-surface-variant;
        state-on-surface: root.palette.on-surface;
        clicked => { root.queue-clicked(); }
    }
}
