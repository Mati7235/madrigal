import { Palette, Type } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { M3IconButton } from "../components/buttons.slint";
import { Icons } from "../components/icons.slint";
import { LyricLineRow } from "models.slint";

export component LyricsView inherits Rectangle {
    in property<Palette> palette;
    in property<[LyricLineRow]> rows;
    in property<int> active-line: -1;
    in property<float> word-progress: 0;
    in property<float> font-px: 16;
    in property<float> spacing-mult: 1.5;
    in property<bool> click-seek: true;

    callback line-seek(int);
    callback share-requested();

    accessible-role: AccessibleRole.list;
    accessible-label: I18n.trl(I18n.lang, "player.tab.lyrics");

    VerticalLayout {
        padding: 12px;
        spacing: 4px;

        lyrics-head := HorizontalLayout {
            spacing: 8px;

            lyrics-title := Text {
                text: I18n.trl(I18n.lang, "player.tab.lyrics");
                color: root.palette.on-surface;
                font-size: Type.title-large.size;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            lyrics-share := M3IconButton {
                icon: Icons.save;
                icon-color: root.palette.on-surface-variant;
                content: root.palette.on-surface-variant;
                state-on-surface: root.palette.on-surface;
                clicked => { root.share-requested(); }
            }
        }

        lyrics-empty := Text {
            text: I18n.trl(I18n.lang, "player.noLyrics");
            color: root.palette.on-surface-variant;
            font-size: Type.body-medium.size;
            wrap: word-wrap;
            visible: root.rows.length == 0;
        }

        lyrics-list := Rectangle {
            vertical-stretch: 1;
            clip: true;

            lyrics-rows := VerticalLayout {
                x: 0px;
                y: 0px;
                width: 100%;
                spacing: 4px;

                for idx in root.rows.length: line-col := Rectangle {
                    height: (root.rows[idx].translation == "" ? root.font-px * 1.8 + 14 : root.font-px * 3.0 + 18) * 1px;
                    clip: true;

                    VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        spacing: 2px;
                        padding-top: (root.spacing-mult * 2) * 1px;

                        line-main := Text {
                            text: root.rows[idx].text;
                            color: idx == root.active-line ? root.palette.primary : root.palette.on-surface;
                            font-size: root.font-px * 1px;
                            font-weight: idx == root.active-line ? 600 : 400;
                            wrap: word-wrap;
                        }

                        line-trans := Text {
                            text: root.rows[idx].translation;
                            color: root.palette.on-surface-variant;
                            font-size: root.font-px * 0.85px;
                            wrap: word-wrap;
                            visible: root.rows[idx].translation != "";
                        }

                        line-sweep := Rectangle {
                            height: 3px;
                            border-radius: 2px;
                            background: root.palette.surface-container-highest;
                            visible: idx == root.active-line;

                            line-fill := Rectangle {
                                width: parent.width * clamp(root.word-progress, 0, 1);
                                height: 100%;
                                border-radius: 2px;
                                background: root.palette.primary;
                            }
                        }
                    }

                    line-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        enabled: root.click-seek;
                        mouse-cursor: root.click-seek ? pointer : default;
                        clicked => { root.line-seek(root.rows[idx].start); }
                    }
                }
            }
        }
    }
}
