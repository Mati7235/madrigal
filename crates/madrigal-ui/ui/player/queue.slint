import { Palette, Type } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { M3IconButton } from "../components/buttons.slint";
import { Icon, Icons } from "../components/icons.slint";
import { QueueRow } from "models.slint";

export component QueueDrawer inherits Rectangle {
    in property<Palette> palette;
    in property<int> tab: 0;
    in property<bool> locked: false;
    in property<int> total-count: 0;
    in property<[QueueRow]> rows-all;
    in property<[QueueRow]> rows-searched;
    in property<[QueueRow]> rows-continue;
    in property<[QueueRow]> rows-auto;

    callback close-clicked();
    callback lock-clicked();
    callback tab-selected(int);
    callback row-play(int);
    callback row-remove(int);
    callback drag-start(int, length);
    callback drag-move(length);
    callback drag-end();

    accessible-role: AccessibleRole.list;
    accessible-label: I18n.trl(I18n.lang, "player.tab.queue");

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        queue-head := HorizontalLayout {
            spacing: 8px;

            queue-title := Text {
                text: I18n.trl(I18n.lang, "player.tab.queue") + " (" + root.total-count + ")";
                color: root.palette.on-surface;
                font-size: Type.title-large.size;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            queue-lock := M3IconButton {
                icon: root.locked ? Icons.x : Icons.list-music;
                icon-color: root.locked ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                selected: root.locked;
                content: root.palette.on-surface-variant;
                state-on-surface: root.palette.on-surface;
                clicked => { root.lock-clicked(); }
            }

            queue-close := M3IconButton {
                icon: Icons.chevron-down;
                icon-color: root.palette.on-surface-variant;
                content: root.palette.on-surface-variant;
                state-on-surface: root.palette.on-surface;
                clicked => { root.close-clicked(); }
            }
        }

        queue-tabs := HorizontalLayout {
            spacing: 4px;

            for t in 4: tab-cell := Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: 18px;
                background: root.tab == t ? root.palette.secondary-container : transparent;

                tab-label := Text {
                    text: t == 0 ? I18n.trl(I18n.lang, "queue.tab.all") : t == 1 ? I18n.trl(I18n.lang, "queue.tab.searched") : t == 2 ? I18n.trl(I18n.lang, "queue.tab.continue") : I18n.trl(I18n.lang, "queue.tab.autoplaying");
                    color: root.tab == t ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                    font-size: Type.label-large.size;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                    overflow: elide;
                }

                tab-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.tab-selected(t); }
                }
            }
        }

        queue-list := Rectangle {
            vertical-stretch: 1;
            clip: true;

            for t in 4: tab-page := Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                visible: root.tab == t;

                property<[QueueRow]> page-rows: t == 0 ? root.rows-all : t == 1 ? root.rows-searched : t == 2 ? root.rows-continue : root.rows-auto;

                page-col := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    spacing: 4px;

                    for idx in page-rows.length: row-box := Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: page-rows[idx].current ? root.palette.secondary-container : transparent;

                        row-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.row-play(idx); }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                    root.drag-start(idx, self.mouse-y);
                                }
                                if (e.kind == PointerEventKind.up) {
                                    root.drag-end();
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag-move(self.mouse-y);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            row-mark := Icon {
                                source: Icons.play;
                                colorize: root.palette.primary;
                                icon-size: 16px;
                                visible: page-rows[idx].current;
                            }

                            row-texts := VerticalLayout {
                                spacing: 0px;
                                horizontal-stretch: 1;

                                row-title := Text {
                                    text: page-rows[idx].title;
                                    color: page-rows[idx].current ? root.palette.on-secondary-container : root.palette.on-surface;
                                    font-size: Type.body-large.size;
                                    font-weight: page-rows[idx].current ? 600 : 400;
                                    overflow: elide;
                                }

                                row-sub := Text {
                                    text: page-rows[idx].artist;
                                    color: root.palette.on-surface-variant;
                                    font-size: Type.body-medium.size;
                                    overflow: elide;
                                }
                            }

                            row-remove := M3IconButton {
                                icon: Icons.minus;
                                icon-color: root.palette.on-surface-variant;
                                content: root.palette.on-surface-variant;
                                state-on-surface: root.palette.on-surface;
                                visible: !root.locked;
                                clicked => { root.row-remove(idx); }
                            }
                        }
                    }
                }
            }
        }
    }
}
