import { Font, Palette, Type } from "../tokens.slint";
import { I18n } from "../i18n.slint";

export component ConfirmOverlay inherits Rectangle {
    in property<Palette> palette;
    in property<string> title;
    in property<string> body;
    callback accepted();
    callback dismissed();

    accessible-role: text;
    accessible-label: root.title;

    scrim-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.dismissed(); }
    }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            confirm-card := Rectangle {
                width: 400px;
                height: 228px;
                border-radius: 12px;
                background: root.palette.surface-container-high;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    confirm-title := Text {
                        text: root.title;
                        color: root.palette.on-surface;
                        font-size: Type.title-large.size;
                        font-family: Type.title-large.family;
                        font-weight: Type.title-large.weight;
                    }
                    confirm-body := Text {
                        text: root.body;
                        color: root.palette.on-surface-variant;
                        font-size: Type.body-medium.size;
                        font-family: Type.body-medium.family;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        confirm-cancel := Rectangle {
                            width: 110px;
                            height: 40px;
                            border-radius: 20px;
                            background: root.palette.surface-container-highest;
                            cancel-label := Text {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                text: I18n.trl(I18n.lang, "confirm.cancel");
                                color: root.palette.on-surface;
                                font-size: Type.label-large.size;
                                font-family: Type.label-large.family;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            cancel-touch := TouchArea {
                                accessible-label: I18n.trl(I18n.lang, "confirm.cancel");
                                accessible-role: button;
                                mouse-cursor: pointer;
                                clicked => { root.dismissed(); }
                            }
                        }
                        confirm-accept := Rectangle {
                            width: 110px;
                            height: 40px;
                            border-radius: 20px;
                            background: root.palette.primary;
                            accept-label := Text {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                text: I18n.trl(I18n.lang, "prompt.ok");
                                color: root.palette.on-primary;
                                font-size: Type.label-large.size;
                                font-family: Type.label-large.family;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            accept-touch := TouchArea {
                                accessible-label: I18n.trl(I18n.lang, "prompt.ok");
                                accessible-role: button;
                                mouse-cursor: pointer;
                                clicked => { root.accepted(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component PromptOverlay inherits Rectangle {
    in property<Palette> palette;
    in property<string> title;
    in-out property<string> input;
    callback accepted(string);
    callback dismissed();

    accessible-role: text;
    accessible-label: root.title;

    prompt-scrim-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.dismissed(); }
    }

    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            prompt-card := Rectangle {
                width: 400px;
                height: 232px;
                border-radius: 12px;
                background: root.palette.surface-container-high;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    prompt-title := Text {
                        text: root.title;
                        color: root.palette.on-surface;
                        font-size: Type.title-large.size;
                        font-family: Type.title-large.family;
                        font-weight: Type.title-large.weight;
                    }
                    prompt-field-bg := Rectangle {
                        height: 48px;
                        border-radius: 8px;
                        background: root.palette.surface-container;
                        border-width: 1px;
                        border-color: root.palette.outline;
                        prompt-field := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: 100%;
                            text <=> root.input;
                            color: root.palette.on-surface;
                            font-size: 16px;
                            font-family: Font.body;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        prompt-cancel := Rectangle {
                            width: 110px;
                            height: 40px;
                            border-radius: 20px;
                            background: root.palette.surface-container-highest;
                            prompt-cancel-label := Text {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                text: I18n.trl(I18n.lang, "confirm.cancel");
                                color: root.palette.on-surface;
                                font-size: Type.label-large.size;
                                font-family: Type.label-large.family;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            prompt-cancel-touch := TouchArea {
                                accessible-label: I18n.trl(I18n.lang, "confirm.cancel");
                                accessible-role: button;
                                mouse-cursor: pointer;
                                clicked => { root.dismissed(); }
                            }
                        }
                        prompt-ok := Rectangle {
                            width: 110px;
                            height: 40px;
                            border-radius: 20px;
                            background: root.palette.primary;
                            prompt-ok-label := Text {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                text: I18n.trl(I18n.lang, "prompt.ok");
                                color: root.palette.on-primary;
                                font-size: Type.label-large.size;
                                font-family: Type.label-large.family;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            prompt-ok-touch := TouchArea {
                                accessible-label: I18n.trl(I18n.lang, "prompt.ok");
                                accessible-role: button;
                                mouse-cursor: pointer;
                                clicked => { root.accepted(root.input); }
                            }
                        }
                    }
                }
            }
        }
    }
}
