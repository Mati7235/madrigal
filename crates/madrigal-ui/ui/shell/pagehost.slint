import { Palette, Type } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { LibSongRow, LibPlaylistRow, LibCardRow, HistoryRow, StatRow, DownloadRow } from "../pages/library/models.slint";
import { LibraryPage } from "../pages/library/library.slint";
import { DownloadsPage } from "../pages/library/downloads.slint";
import { CatalogItem, CatalogSection, DetailRef, MoodEntry } from "../pages/catalog/refs.slint";
import { DetailKind } from "../pages/catalog/refs.slint";
import { HomePage } from "../pages/catalog/home.slint";
import { SearchPage } from "../pages/catalog/search.slint";
import { ExplorePage } from "../pages/catalog/explore.slint";
import { DetailPage } from "../pages/catalog/detail.slint";
import { SettingsPage } from "../pages/settings/settings.slint";
import { SettingsRow, DiagLine } from "../pages/settings/rows.slint";

export component PageHost inherits Rectangle {
    in property<int> page;
    in property<Palette> palette;
    in property<[string]> lib-chips;
    in property<int> lib-tab;
    in property<bool> lib-chip-edit;
    in property<[string]> lib-tags;
    in property<string> lib-active-tag;
    in property<[LibSongRow]> lib-songs;
    in property<[LibPlaylistRow]> lib-playlists;
    in property<[LibCardRow]> lib-cards;
    in property<[string]> lib-sort-options;
    in property<int> lib-sort;
    in property<bool> lib-sort-open;
    in property<bool> lib-multiselect;
    in property<int> lib-selected-count;
    in property<bool> lib-tags-open;
    in-out property<string> lib-tag-input;
    in property<[HistoryRow]> lib-history;
    in property<bool> lib-history-paused;
    in property<[StatRow]> lib-stat-tracks;
    in property<[StatRow]> lib-stat-artists;
    in property<[StatRow]> lib-stat-albums;
    in property<string> lib-stats-totals;
    in property<string> lib-stats-streaks;
    in property<[string]> lib-years;
    in property<int> lib-year;
    in property<[DownloadRow]> dl-rows;
    in property<[DownloadRow]> dl-failed;

    callback lib-chip-selected(int);
    callback lib-chip-move-left();
    callback lib-chip-move-right();
    callback lib-chip-edit-toggled();
    callback lib-tag-selected(string);
    callback lib-tags-opened();
    callback lib-tags-closed();
    callback lib-tag-created(string);
    callback lib-tag-removed(string);
    callback lib-sort-opened();
    callback lib-sort-closed();
    callback lib-sort-selected(int);
    callback lib-song-toggled(string);
    callback lib-song-chosen(string);
    callback lib-multiselect-toggled();
    callback lib-selection-cleared();
    callback lib-playlist-opened(string);
    callback lib-history-cleared();
    callback lib-year-prev();
    callback lib-year-next();
    callback dl-pause(string);
    callback dl-resume(string);
    callback dl-cancel(string);
    callback dl-retry(string);
    callback dl-retry-all();
    in property<bool> search-focused: false;
    in-out property<int> detail-stack: 0;
    in-out property<DetailRef> detail-ref: { kind: DetailKind.album, id: "" };

    in property<[string]> home-chips;
    in-out property<int> home-current-chip: 0;
    in property<[CatalogSection]> home-sections;
    in property<[CatalogItem]> home-quick-picks;
    in property<[CatalogItem]> home-pins;
    in property<bool> home-card-layout: true;
    in-out property<int> home-selected-item: -1;

    in-out property<string> search-query: "";
    in property<[string]> search-suggestions;
    in-out property<int> search-suggestion-index: -1;
    in-out property<int> search-filter-tab: 0;
    in property<[CatalogItem]> search-results;
    in-out property<int> search-source: 1;

    in property<[MoodEntry]> explore-moods-left;
    in property<[MoodEntry]> explore-moods-right;
    in property<string> explore-charts-id: "charts:";
    in-out property<int> explore-releases-tab: 0;
    in property<[CatalogItem]> explore-releases-albums;
    in property<[CatalogItem]> explore-releases-videos;
    in property<[CatalogSection]> explore-browse-sections;

    in property<string> detail-title: "";
    in property<string> detail-subtitle: "";
    in property<string> detail-description: "";
    in property<[CatalogItem]> detail-tracks;
    in property<[CatalogItem]> detail-albums;
    in property<[CatalogSection]> detail-sections;
    in-out property<int> detail-tab: 0;

    callback chip-selected(int);
    callback query-changed(string);
    callback suggestion-accepted(string);
    callback filter-selected(int);
    callback source-selected(int);
    callback detail-requested(DetailRef);
    callback play-requested(string);
    callback detail-closed();
    in-out property<int> settings-group;
    in property<[string]> settings-group-titles;
    in property<[SettingsRow]> settings-rows;
    in-out property<bool> settings-show-diag;
    in property<[DiagLine]> settings-diag-entries;
    in property<int> settings-diag-entry-count;
    in-out property<int> settings-diag-level;
    in property<string> settings-diag-latency;
    in property<string> settings-diag-single;
    in property<string> settings-diag-export-status;
    in property<bool> settings-diag-exported;
    in property<string> settings-test-result;
    in property<bool> settings-po-done;
    in property<bool> settings-po-ok;
    in-out property<bool> settings-show-onboarding;
    in-out property<int> settings-ob-step;
    in-out property<string> settings-ob-folder;

    callback settings-group-selected(int);
    callback settings-toggled(string, bool);
    callback settings-edited(string, string);
    callback settings-stepped(string, float);
    callback settings-chosen(string, string);
    callback settings-cycled(string);
    callback settings-secret-toggled(string);
    callback settings-provider-moved(string, int, float);
    callback settings-provider-toggled(string, string, bool);
    callback settings-test(string);
    callback settings-login(string);
    callback settings-lang-picked(string);
    callback settings-scan-folder();
    callback settings-po-check();
    callback settings-onboarding-finished();
    callback settings-diag-level-selected(int);
    callback settings-diag-export();

    property<string> title: root.page == 0 ? I18n.trl(I18n.lang, "nav.home") : root.page == 1 ? I18n.trl(I18n.lang, "explore.search") : root.page == 2 ? I18n.trl(I18n.lang, "nav.explore") : root.page == 3 ? I18n.trl(I18n.lang, "nav.lists") : root.page == 4 ? I18n.trl(I18n.lang, "nav.downloads") : I18n.trl(I18n.lang, "settings.title");

    background: root.palette.surface;
    accessible-role: text;
    accessible-label: root.title;

    if (root.page == 0) : home-page := HomePage {
        width: 100%;
        height: 100%;
        palette: root.palette;
        chips: root.home-chips;
        current-chip <=> root.home-current-chip;
        sections: root.home-sections;
        quick-picks: root.home-quick-picks;
        pins: root.home-pins;
        card-layout: root.home-card-layout;
        selected-item <=> root.home-selected-item;
        chip-selected(i) => { root.chip-selected(i); }
        detail-requested(ref) => { root.detail-requested(ref); }
        play-requested(id) => { root.play-requested(id); }
    }

    if (root.page == 1) : search-page := SearchPage {
        width: 100%;
        height: 100%;
        palette: root.palette;
        focus-requested: root.search-focused;
        query <=> root.search-query;
        suggestions: root.search-suggestions;
        suggestion-index <=> root.search-suggestion-index;
        filter-tab <=> root.search-filter-tab;
        results: root.search-results;
        source <=> root.search-source;
        query-changed(text) => { root.query-changed(text); }
        suggestion-accepted(text) => { root.suggestion-accepted(text); }
        filter-selected(i) => { root.filter-selected(i); }
        source-selected(i) => { root.source-selected(i); }
        detail-requested(ref) => { root.detail-requested(ref); }
        play-requested(id) => { root.play-requested(id); }
    }

    if (root.page == 2) : explore-page := ExplorePage {
        width: 100%;
        height: 100%;
        palette: root.palette;
        moods-left: root.explore-moods-left;
        moods-right: root.explore-moods-right;
        charts-id: root.explore-charts-id;
        releases-tab <=> root.explore-releases-tab;
        releases-albums: root.explore-releases-albums;
        releases-videos: root.explore-releases-videos;
        browse-sections: root.explore-browse-sections;
        detail-requested(ref) => { root.detail-requested(ref); }
        play-requested(id) => { root.play-requested(id); }
    }

    if (root.page == 3) : library-host := LibraryPage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        palette: root.palette;
        chips: root.lib-chips;
        tab: root.lib-tab;
        chip-edit: root.lib-chip-edit;
        tags: root.lib-tags;
        active-tag: root.lib-active-tag;
        songs: root.lib-songs;
        playlists: root.lib-playlists;
        cards: root.lib-cards;
        sort-options: root.lib-sort-options;
        sort: root.lib-sort;
        sort-open: root.lib-sort-open;
        multiselect: root.lib-multiselect;
        selected-count: root.lib-selected-count;
        tags-open: root.lib-tags-open;
        tag-input <=> root.lib-tag-input;
        history: root.lib-history;
        history-paused: root.lib-history-paused;
        stat-tracks: root.lib-stat-tracks;
        stat-artists: root.lib-stat-artists;
        stat-albums: root.lib-stat-albums;
        stats-totals: root.lib-stats-totals;
        stats-streaks: root.lib-stats-streaks;
        years: root.lib-years;
        year: root.lib-year;
        chip-selected(i) => { root.lib-chip-selected(i); }
        chip-move-left() => { root.lib-chip-move-left(); }
        chip-move-right() => { root.lib-chip-move-right(); }
        chip-edit-toggled() => { root.lib-chip-edit-toggled(); }
        tag-selected(t) => { root.lib-tag-selected(t); }
        tags-opened() => { root.lib-tags-opened(); }
        tags-closed() => { root.lib-tags-closed(); }
        tag-created(t) => { root.lib-tag-created(t); }
        tag-removed(t) => { root.lib-tag-removed(t); }
        sort-opened() => { root.lib-sort-opened(); }
        sort-closed() => { root.lib-sort-closed(); }
        sort-selected(i) => { root.lib-sort-selected(i); }
        song-toggled(id) => { root.lib-song-toggled(id); }
        song-chosen(id) => { root.lib-song-chosen(id); }
        multiselect-toggled() => { root.lib-multiselect-toggled(); }
        selection-cleared() => { root.lib-selection-cleared(); }
        playlist-opened(id) => { root.lib-playlist-opened(id); }
        history-cleared() => { root.lib-history-cleared(); }
        year-prev() => { root.lib-year-prev(); }
        year-next() => { root.lib-year-next(); }
    }

    if (root.page == 4) : downloads-host := DownloadsPage {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        palette: root.palette;
        rows: root.dl-rows;
        failed: root.dl-failed;
        dl-pause(id) => { root.dl-pause(id); }
        dl-resume(id) => { root.dl-resume(id); }
        dl-cancel(id) => { root.dl-cancel(id); }
        dl-retry(id) => { root.dl-retry(id); }
        dl-retry-all() => { root.dl-retry-all(); }
    }

    if (root.page == 5) : settings-page := SettingsPage {
        width: 100%;
        height: 100%;
        palette: root.palette;
        group <=> root.settings-group;
        group-titles: root.settings-group-titles;
        rows: root.settings-rows;
        show-diag <=> root.settings-show-diag;
        diag-entries: root.settings-diag-entries;
        diag-entry-count: root.settings-diag-entry-count;
        diag-level <=> root.settings-diag-level;
        diag-latency: root.settings-diag-latency;
        diag-single: root.settings-diag-single;
        diag-export-status: root.settings-diag-export-status;
        diag-exported: root.settings-diag-exported;
        test-result: root.settings-test-result;
        po-done: root.settings-po-done;
        po-ok: root.settings-po-ok;
        show-onboarding <=> root.settings-show-onboarding;
        ob-step <=> root.settings-ob-step;
        ob-folder <=> root.settings-ob-folder;
        group-selected(i) => { root.settings-group-selected(i); }
        setting-toggled(k, v) => { root.settings-toggled(k, v); }
        setting-edited(k, v) => { root.settings-edited(k, v); }
        setting-stepped(k, v) => { root.settings-stepped(k, v); }
        setting-chosen(k, v) => { root.settings-chosen(k, v); }
        setting-cycled(k) => { root.settings-cycled(k); }
        secret-toggled(k) => { root.settings-secret-toggled(k); }
        provider-moved(k, f, d) => { root.settings-provider-moved(k, f, d); }
        provider-toggled(k, p, v) => { root.settings-provider-toggled(k, p, v); }
        test-connection(t) => { root.settings-test(t); }
        login-requested(l) => { root.settings-login(l); }
        lang-picked(l) => { root.settings-lang-picked(l); }
        scan-folder() => { root.settings-scan-folder(); }
        po-check() => { root.settings-po-check(); }
        onboarding-finished() => { root.settings-onboarding-finished(); }
        diag-level-selected(l) => { root.settings-diag-level-selected(l); }
        diag-export() => { root.settings-diag-export(); }
    }

    if (root.detail-stack == 1) : detail-view := DetailPage {
        width: 100%;
        height: 100%;
        palette: root.palette;
        detail: root.detail-ref;
        title: root.detail-title;
        subtitle: root.detail-subtitle;
        description: root.detail-description;
        tracks: root.detail-tracks;
        albums: root.detail-albums;
        sections: root.detail-sections;
        detail-tab <=> root.detail-tab;
        back-requested => {
            root.detail-stack = 0;
            root.detail-closed();
        }
        detail-requested(ref) => { root.detail-requested(ref); }
        play-requested(id) => { root.play-requested(id); }
    }
}
