    callback navigate(int);
    callback open-confirm(string, string);
    callback open-prompt(string);
    callback close-overlay();
    callback confirm-accepted();
    callback confirm-dismissed();
    callback prompt-accepted(string);
    callback prompt-dismissed();
    callback handle-key(string) -> bool;
    callback player-state-changed();
    callback play-pause-toggled();
    callback seek-requested(int);
    callback next-requested();
    callback prev-requested();
    callback full-player-opened();
    callback search-focus-requested();
    callback lib-chip-selected(int);
    callback lib-chip-move-left();
    callback lib-chip-move-right();
    callback lib-chip-edit-toggled();
    callback lib-tag-selected(string);
    callback lib-tags-opened();
    callback lib-tags-closed();
    callback lib-tag-created(string);
    callback lib-tag-removed(string);
    callback lib-sort-opened();
    callback lib-sort-closed();
    callback lib-sort-selected(int);
    callback lib-song-toggled(string);
    callback lib-song-chosen(string);
    callback lib-multiselect-toggled();
    callback lib-selection-cleared();
    callback lib-playlist-opened(string);
    callback lib-history-cleared();
    callback lib-year-prev();
    callback lib-year-next();
    callback dl-pause(string);
    callback dl-resume(string);
    callback dl-cancel(string);
    callback dl-retry(string);
    callback dl-retry-all();

    function lib-record(action: string) {
        root.lib-action-count += 1;
        root.lib-last-action = action;
    }

    function dl-record(action: string) {
        root.dl-action-count += 1;
        root.dl-last-action = action;
    }

    lib-chip-selected(i) => {
        root.lib-record("chip-selected");
        root.lib-tab = i;
    }
    lib-chip-move-left() => { root.lib-record("chip-move-left"); }
    lib-chip-move-right() => { root.lib-record("chip-move-right"); }
    lib-chip-edit-toggled() => {
        root.lib-record("chip-edit-toggled");
        root.lib-chip-edit = !root.lib-chip-edit;
    }
    lib-tag-selected(t) => {
        root.lib-record("tag-selected");
        root.lib-active-tag = t;
    }
    lib-tags-opened() => {
        root.lib-record("tags-opened");
        root.lib-tags-open = true;
    }
    lib-tags-closed() => {
        root.lib-record("tags-closed");
        root.lib-tags-open = false;
    }
    lib-tag-created(t) => { root.lib-record("tag-created"); root.lib-last-arg = t; }
    lib-tag-removed(t) => { root.lib-record("tag-removed"); root.lib-last-arg = t; }
    lib-sort-opened() => {
        root.lib-record("sort-opened");
        root.lib-sort-open = true;
    }
    lib-sort-closed() => {
        root.lib-record("sort-closed");
        root.lib-sort-open = false;
    }
    lib-sort-selected(i) => {
        root.lib-record("sort-selected");
        root.lib-sort = i;
        root.lib-sort-open = false;
    }
    lib-song-toggled(id) => { root.lib-record("song-toggled"); root.lib-last-arg = id; }
    lib-song-chosen(id) => { root.lib-record("song-chosen"); root.lib-last-arg = id; }
    lib-multiselect-toggled() => {
        root.lib-record("multiselect-toggled");
        root.lib-multiselect = !root.lib-multiselect;
    }
    lib-selection-cleared() => { root.lib-record("selection-cleared"); }
    lib-playlist-opened(id) => { root.lib-record("playlist-opened"); root.lib-last-arg = id; }
    lib-history-cleared() => { root.lib-record("history-cleared"); }
    lib-year-prev() => {
        root.lib-record("year-prev");
        if (root.lib-year > 0) {
            root.lib-year -= 1;
        }
    }
    lib-year-next() => {
        root.lib-record("year-next");
        if (root.lib-year < root.lib-years.length - 1) {
            root.lib-year += 1;
        }
    }
    dl-pause(id) => { root.dl-record("dl-pause"); }
    dl-resume(id) => { root.dl-record("dl-resume"); }
    dl-cancel(id) => { root.dl-record("dl-cancel"); }
    dl-retry(id) => { root.dl-record("dl-retry"); }
    dl-retry-all() => { root.dl-record("dl-retry-all"); }
    recent-accepted(t) => {
        root.search-query = t;
        root.query-changed(t);
        root.search-submit-count += 1;
        root.search-last-submitted = t;
    }
    recent-removed(t) => {
        root.search-remove-count += 1;
        root.search-last-removed = t;
    }
    recent-cleared() => { root.search-clear-count += 1; }
    callback like-toggled();
    callback queue-opened();
    callback queue-closed();
    callback full-player-closed();
    callback repeat-toggled();
    callback shuffle-toggled();
