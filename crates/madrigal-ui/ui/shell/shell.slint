    callback lyrics-seek-requested(int);
    callback lyrics-share-requested();
    callback lyrics-offset-changed(int);
    callback lyrics-retry-requested();
    callback queue-play-requested(int);
    callback queue-remove-requested(int);
    callback queue-move-requested(int, int);
    callback queue-tab-selected(int);
    callback queue-lock-toggled();
    callback player-dialog-requested(int);
    callback player-dialog-dismissed();
    callback sleep-selected(int, int);
    callback tempo-committed();
    callback tempo-reset();
    callback eq-toggled(bool);
    callback eq-band-changed(int, float);
    callback eq-preset-selected(string);
    callback error-retried();
    callback drag-start(int, length);
    callback drag-move(length);
    callback drag-end();
    pure callback line-at(int) -> int;
    pure callback line-progress(int) -> float;
    callback chip-selected(int);
    callback query-changed(string);
    callback suggestion-accepted(string);
    callback filter-selected(int);
    callback source-selected(int);
    callback recent-accepted(string);
    callback recent-removed(string);
    callback recent-cleared();
    callback detail-requested(DetailRef);
    callback detail-opened(DetailRef);
    callback play-requested(CatalogItem);
    callback detail-closed();
    callback settings-group-selected(int);
    callback settings-toggled(string, bool);
    callback settings-edited(string, string);
    callback settings-stepped(string, float);
    callback settings-chosen(string, string);
    callback settings-cycled(string);
    callback settings-secret-toggled(string);
    callback settings-provider-moved(string, int, float);
    callback settings-provider-toggled(string, string, bool);
    callback settings-test(string);
    callback settings-login(string);
    callback settings-lang-picked(string);
    callback settings-scan-folder();
    callback settings-po-check();
    callback settings-onboarding-finished();
    callback settings-diag-level-selected(int);
    callback settings-diag-export();

    apply-theme(k) => {
        if (k == 0) {
            root.palette = Light.palette;
        } else if (k == 1) {
            root.palette = Dark.palette;
        } else {
            root.palette = PureBlack.palette;
        }
        root.theme-kind = k;
    }

    changed paused => { root.player-state-changed(); }
    changed full-player-open => { root.player-state-changed(); }
    changed has-track => { root.player-state-changed(); }

    navigate(p) => {
        root.page = p;
    }

    open-confirm(t, b) => {
        root.confirm-title = t;
        root.confirm-body = b;
        root.confirm-result = -1;
        root.overlay = 1;
    }

    open-prompt(t) => {
        root.prompt-title = t;
        root.prompt-input = "";
        root.prompt-result = "";
        root.overlay = 2;
    }

    close-overlay() => {
        root.overlay = 0;
    }

    confirm-accepted() => {
        root.confirm-result = 1;
        root.overlay = 0;
    }

    confirm-dismissed() => {
        root.confirm-result = 0;
        root.overlay = 0;
    }

    prompt-accepted(text) => {
        root.prompt-result = text;
        root.overlay = 0;
    }

    prompt-dismissed() => {
        root.overlay = 0;
    }

    detail-requested(ref) => {
        root.detail-ref = ref;
        root.detail-stack = 1;
        root.detail-opened(ref);
    }

    detail-opened(ref) => {
    }

    detail-closed() => {
        root.detail-stack = 0;
    }

    handle-key(key) => {
        if (key == "Escape") {
            if (root.player-dialog != 0) {
                root.player-dialog = 0;
                root.player-dialog-dismissed();
                return true;
            }
            if (root.queue-open) {
                root.queue-open = false;
                root.queue-closed();
                return true;
            }
            if (root.full-player-open) {
                root.full-player-open = false;
                root.player-dialog = 0;
                root.full-player-closed();
                return true;
            }
            if (root.overlay == 1) {
                root.confirm-dismissed();
                return true;
            }
            if (root.overlay == 2) {
                root.prompt-dismissed();
                return true;
            }
            if (root.detail-stack == 1) {
                root.detail-stack = 0;
                root.detail-closed();
                return true;
            }
            root.sidebar-focused = true;
            return true;
        }
        if (root.overlay != 0) {
            return false;
        }
        if (key == " ") {
            root.play-toggle-count += 1;
            root.play-pause-toggled();
            return true;
        }
        if (key == "Left") {
            root.seek-back-count += 1;
            root.seek-delta = -10;
            root.seek-requested(-10);
            return true;
        }
        if (key == "Right") {
            root.seek-fwd-count += 1;
            root.seek-delta = 10;
            root.seek-requested(10);
            return true;
        }
        if (key == "n" || key == "N") {
            root.next-count += 1;
            root.next-requested();
            return true;
        }
        if (key == "p" || key == "P") {
            root.prev-count += 1;
            root.prev-requested();
            return true;
        }
        if (key == "f" || key == "F") {
            root.full-player-count += 1;
            root.full-player-opened();
            return true;
        }
        if (key == "/") {
            root.search-focus-count += 1;
            root.search-focused = true;
            if (root.page <= 2) {
                top-bar.focus-input();
            } else if (root.page <= 4) {
                local-bar.focus-input();
            }
            root.search-focus-requested();
            return true;
        }
        if (key == "]") {
            if (root.page >= 5) {
                root.page = 0;
            } else {
                root.page += 1;
            }
            return true;
        }
        if (key == "[") {
            if (root.page <= 0) {
                root.page = 5;
            } else {
                root.page -= 1;
            }
            return true;
        }
        if (key == "1") {
            root.page = 0;
            return true;
        }
        if (key == "2") {
            root.page = 1;
            return true;
        }
        if (key == "3") {
            root.page = 2;
            return true;
        }
        if (key == "4") {
            root.page = 3;
            return true;
        }
        if (key == "5") {
            root.page = 4;
            return true;
        }
        if (key == "6") {
            root.page = 5;
            return true;
        }
        return false;
    }

    title: "madrigal-shell";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 480px;
    background: root.palette.surface;

    property<bool> nav-expanded: root.width >= 1100px;
    property<bool> nowbar-compact: root.width < 840px;
    property<length> queue-width: root.width < 800px ? root.width : 380px;

    out property<length> nowbar-width: nowbar.width;
    out property<length> nowbar-bottom: nowbar.y + nowbar.height;

    main-row := HorizontalLayout {
        y: 0px;
        width: 100%;
        height: root.height - 96px;
        spacing: 0px;
        nav := SideNav {
            width: root.nav-expanded ? 244px : 80px;
            expanded: root.nav-expanded;
            palette: root.palette;
            page: root.page;
            focused: root.sidebar-focused;
            navigate(p) => { root.navigate(p); }
        }
        content-col := VerticalLayout {
            spacing: 0px;
            topbar-row := Rectangle {
                width: 100%;
                height: root.page <= 2 ? 56px : 0px;
                visible: root.page <= 2;
                background: root.palette.surface;
                top-bar := M3SearchBar {
                    x: 16px;
                    y: 8px;
                    width: Math.min(560px, parent.width - 32px);
                    height: 48px;
                    value <=> root.search-query;
                    ring: root.search-focused;
                    hint: I18n.trl(I18n.lang, "search.musicHint");
                    fill: root.palette.surface-container-high;
                    content: root.palette.on-surface;
                    focus-line: root.palette.primary;
                    hint-color: root.palette.on-surface-variant;
                    state-on-surface: root.palette.on-surface;
                    clear-label: I18n.trl(I18n.lang, "detail.clear");
                    accepted(text) => {
                        if (root.page == 1 && root.search-suggestion-index >= 0 && root.search-suggestion-index < root.search-suggestions.length) {
                            root.search-query = root.search-suggestions[root.search-suggestion-index];
                            root.suggestion-accepted(root.search-query);
                        } else {
                            root.search-query = text;
                            root.query-changed(text);
                        }
                        root.search-submit-count += 1;
                        root.search-last-submitted = root.search-query;
                        root.page = 1;
                    }
                    nav-key(text) => {
                        if (root.page == 1) {
                            if (text == Key.UpArrow) {
                                if (root.search-suggestions.length > 0) {
                                    root.search-suggestion-index = Math.max(root.search-suggestion-index - 1, 0);
                                }
                                return true;
                            }
                            if (text == Key.DownArrow) {
                                if (root.search-suggestions.length > 0) {
                                    root.search-suggestion-index = Math.min(root.search-suggestion-index + 1, root.search-suggestions.length - 1);
                                }
                                return true;
                            }
                        }
                        return false;
                    }
                }
            }
            localbar-row := Rectangle {
                width: 100%;
                height: root.page == 3 || root.page == 4 ? 56px : 0px;
                visible: root.page == 3 || root.page == 4;
                background: root.palette.surface;
                local-bar := M3SearchBar {
                    x: 16px;
                    y: 8px;
                    width: Math.min(560px, parent.width - 32px);
                    height: 48px;
                    value <=> root.local-query;
                    ring: root.search-focused;
                    hint: I18n.trl(I18n.lang, "search.downloadedHint");
                    fill: root.palette.surface-container-high;
                    content: root.palette.on-surface;
                    focus-line: root.palette.primary;
                    hint-color: root.palette.on-surface-variant;
                    state-on-surface: root.palette.on-surface;
                    clear-label: I18n.trl(I18n.lang, "detail.clear");
                    accepted(text) => { root.local-query = text; }
                }
            }
            host := PageHost {
                vertical-stretch: 1;
                palette: root.palette;
                page: root.page;
                lib-chips: root.lib-chips;
                lib-tab: root.lib-tab;
                lib-chip-edit: root.lib-chip-edit;
                lib-tags: root.lib-tags;
                lib-active-tag: root.lib-active-tag;
                lib-songs: root.lib-songs;
                lib-playlists: root.lib-playlists;
                lib-cards: root.lib-cards;
                lib-sort-options: root.lib-sort-options;
                lib-sort: root.lib-sort;
                lib-sort-open: root.lib-sort-open;
                lib-multiselect: root.lib-multiselect;
                lib-selected-count: root.lib-selected-count;
                lib-tags-open: root.lib-tags-open;
                lib-tag-input <=> root.lib-tag-input;
                lib-history: root.lib-history;
                lib-history-paused: root.lib-history-paused;
                lib-stat-tracks: root.lib-stat-tracks;
                lib-stat-artists: root.lib-stat-artists;
                lib-stat-albums: root.lib-stat-albums;
                lib-stats-totals: root.lib-stats-totals;
                lib-stats-streaks: root.lib-stats-streaks;
                lib-years: root.lib-years;
                lib-year: root.lib-year;
                dl-rows: root.dl-rows;
                dl-failed: root.dl-failed;
                lib-chip-selected(i) => { root.lib-chip-selected(i); }
                lib-chip-move-left() => { root.lib-chip-move-left(); }
                lib-chip-move-right() => { root.lib-chip-move-right(); }
                lib-chip-edit-toggled() => { root.lib-chip-edit-toggled(); }
                lib-tag-selected(t) => { root.lib-tag-selected(t); }
                lib-tags-opened() => { root.lib-tags-opened(); }
                lib-tags-closed() => { root.lib-tags-closed(); }
                lib-tag-created(t) => { root.lib-tag-created(t); }
                lib-tag-removed(t) => { root.lib-tag-removed(t); }
                lib-sort-opened() => { root.lib-sort-opened(); }
                lib-sort-closed() => { root.lib-sort-closed(); }
                lib-sort-selected(i) => { root.lib-sort-selected(i); }
                lib-song-toggled(id) => { root.lib-song-toggled(id); }
                lib-song-chosen(id) => { root.lib-song-chosen(id); }
                lib-multiselect-toggled() => { root.lib-multiselect-toggled(); }
                lib-selection-cleared() => { root.lib-selection-cleared(); }
                lib-playlist-opened(id) => { root.lib-playlist-opened(id); }
                lib-history-cleared() => { root.lib-history-cleared(); }
                lib-year-prev() => { root.lib-year-prev(); }
                lib-year-next() => { root.lib-year-next(); }
                dl-pause(id) => { root.dl-pause(id); }
                dl-resume(id) => { root.dl-resume(id); }
                dl-cancel(id) => { root.dl-cancel(id); }
                dl-retry(id) => { root.dl-retry(id); }
                dl-retry-all() => { root.dl-retry-all(); }
                detail-stack <=> root.detail-stack;
                detail-ref <=> root.detail-ref;
                home-chips: root.home-chips;
                home-current-chip <=> root.home-current-chip;
                home-sections: root.home-sections;
                home-quick-picks: root.home-quick-picks;
                home-pins: root.home-pins;
                home-card-layout: root.home-card-layout;
                home-selected-item <=> root.home-selected-item;
                search-query <=> root.search-query;
                search-suggestions: root.search-suggestions;
                search-suggestion-index <=> root.search-suggestion-index;
                search-filter-tab <=> root.search-filter-tab;
                search-results: root.search-results;
                search-recent: root.search-recent;
                search-source <=> root.search-source;
                explore-moods-left: root.explore-moods-left;
                explore-moods-right: root.explore-moods-right;
                explore-charts-id: root.explore-charts-id;
                explore-releases-tab <=> root.explore-releases-tab;
                explore-releases-albums: root.explore-releases-albums;
                explore-releases-videos: root.explore-releases-videos;
                explore-browse-sections: root.explore-browse-sections;
                detail-title: root.detail-title;
                detail-subtitle: root.detail-subtitle;
                detail-description: root.detail-description;
                detail-tracks: root.detail-tracks;
                detail-albums: root.detail-albums;
                detail-sections: root.detail-sections;
                detail-tab <=> root.detail-tab;
                chip-selected(i) => { root.chip-selected(i); }
                suggestion-accepted(text) => { root.suggestion-accepted(text); }
                filter-selected(i) => { root.filter-selected(i); }
                source-selected(i) => { root.source-selected(i); }
                recent-accepted(text) => { root.recent-accepted(text); }
                recent-removed(text) => { root.recent-removed(text); }
                recent-cleared() => { root.recent-cleared(); }
                detail-requested(ref) => { root.detail-requested(ref); }
                play-requested(item) => { root.play-requested(item); }
                detail-closed() => { root.detail-closed(); }
                settings-group <=> root.settings-group;
                settings-group-titles: root.settings-group-titles;
                settings-rows: root.settings-rows;
                settings-show-diag <=> root.settings-show-diag;
                settings-diag-entries: root.settings-diag-entries;
                settings-diag-entry-count: root.settings-diag-entry-count;
                settings-diag-level <=> root.settings-diag-level;
                settings-diag-latency: root.settings-diag-latency;
                settings-diag-single: root.settings-diag-single;
                settings-diag-export-status: root.settings-diag-export-status;
                settings-diag-exported: root.settings-diag-exported;
                settings-test-result: root.settings-test-result;
                settings-po-done: root.settings-po-done;
                settings-po-ok: root.settings-po-ok;
                settings-account-connected: root.settings-account-connected;
                settings-account-name: root.settings-account-name;
                settings-account-email: root.settings-account-email;
                settings-account-busy: root.settings-account-busy;
                settings-account-error: root.settings-account-error;
                settings-show-onboarding <=> root.settings-show-onboarding;
                settings-ob-step <=> root.settings-ob-step;
                settings-ob-folder <=> root.settings-ob-folder;
                settings-group-selected(i) => { root.settings-group-selected(i); }
                settings-toggled(k, v) => { root.settings-toggled(k, v); }
                settings-edited(k, v) => { root.settings-edited(k, v); }
                settings-stepped(k, v) => { root.settings-stepped(k, v); }
                settings-chosen(k, v) => { root.settings-chosen(k, v); }
                settings-cycled(k) => { root.settings-cycled(k); }
                settings-secret-toggled(k) => { root.settings-secret-toggled(k); }
                settings-provider-moved(k, f, d) => { root.settings-provider-moved(k, f, d); }
                settings-provider-toggled(k, p, v) => { root.settings-provider-toggled(k, p, v); }
                settings-test(t) => { root.settings-test(t); }
                settings-login(l) => { root.settings-login(l); }
                settings-lang-picked(l) => { root.settings-lang-picked(l); }
                settings-scan-folder() => { root.settings-scan-folder(); }
                settings-po-check() => { root.settings-po-check(); }
                settings-onboarding-finished() => { root.settings-onboarding-finished(); }
                settings-diag-level-selected(l) => { root.settings-diag-level-selected(l); }
                settings-diag-export() => { root.settings-diag-export(); }
            }
        }
    }

    nowbar := NowPlayingBar {
        y: root.height - 96px;
        width: 100%;
        height: 96px;
        compact: root.nowbar-compact;
        palette: root.palette;
        title: root.track-title;
        artist: root.track-artist;
        has-track: root.has-track;
        cover: root.cover;
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
        paused: root.paused;
        liked: root.liked;
        queue-count: root.queue-count;
        volume: root.volume;
        play-clicked => { root.play-toggle-count += 1; root.play-pause-toggled(); }
        prev-clicked => { root.prev-count += 1; root.prev-requested(); }
        next-clicked => { root.next-count += 1; root.next-requested(); }
        like-clicked => { root.like-toggled(); }
        queue-clicked => { root.queue-open = true; root.queue-opened(); }
        seek-requested(ms) => { root.seek-to-requested(ms); }
        volume-changed(v) => { root.volume-changed(v); }
        expand-clicked => { root.full-player-opened(); }
    }

    confirm-layer := ConfirmOverlay {
        width: 100%;
        height: 100%;
        visible: root.overlay == 1;
        palette: root.palette;
        title: root.confirm-title;
        body: root.confirm-body;
        accepted => { root.confirm-accepted(); }
        dismissed => { root.confirm-dismissed(); }
    }

    prompt-layer := PromptOverlay {
        width: 100%;
        height: 100%;
        visible: root.overlay == 2;
        palette: root.palette;
        title: root.prompt-title;
        input <=> root.prompt-input;
        accepted(text) => { root.prompt-accepted(text); }
        dismissed => { root.prompt-dismissed(); }
    }

    full-layer := FullPlayer {
        y: 0px;
        width: 100%;
        height: root.height - 96px;
        visible: root.full-player-open;
        palette: root.palette;
        title: root.track-title;
        artist: root.track-artist;
        album: root.track-album;
        has-track: root.has-track;
        cover: root.cover;
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
        paused: root.paused;
        liked: root.liked;
        repeat-mode: root.repeat-mode;
        shuffle: root.shuffle;
        volume: root.volume;
        bg-style: root.bg-style;
        panel: root.player-panel;
        lyric-rows: root.lyric-rows;
        active-line: root.active-line;
        active-word: root.active-word;
        word-progress: root.word-progress;
        lyrics-font-px: root.lyrics-font-px;
        lyrics-spacing: root.lyrics-spacing;
        lyrics-offset-ms: root.lyrics-offset-ms;
        lyrics-state: root.lyrics-state;
        lyrics-synced: root.lyrics-synced;
        lyrics-error: root.lyrics-error;
        close-clicked => { root.full-player-open = false; root.player-dialog = 0; root.full-player-closed(); }
        play-clicked => { root.play-toggle-count += 1; root.play-pause-toggled(); }
        prev-clicked => { root.prev-count += 1; root.prev-requested(); }
        next-clicked => { root.next-count += 1; root.next-requested(); }
        like-clicked => { root.like-toggled(); }
        shuffle-clicked => { root.shuffle-toggled(); }
        repeat-clicked => { root.repeat-toggled(); }
        volume-changed(v) => { root.volume-changed(v); }
        seek-to(ms) => { root.seek-to-requested(ms); }
        panel-selected(p) => { root.player-panel = p; }
        info-clicked => { root.player-dialog = 5; root.player-dialog-requested(5); }
        sleep-clicked => { root.player-dialog = 1; root.player-dialog-requested(1); }
        tempo-clicked => { root.player-dialog = 2; root.player-dialog-requested(2); }
        eq-clicked => { root.player-dialog = 3; root.player-dialog-requested(3); }
        lyric-seek(ms) => { root.lyrics-seek-requested(ms); }
        lyric-share => { root.lyrics-share-requested(); }
        lyric-offset(ms) => { root.lyrics-offset-changed(ms); }
        lyric-retry => { root.lyrics-retry-requested(); }
        lyric-scroll-locked(locked) => { root.lyrics-scroll-locked = locked; }
        line-at(t) => { root.line-at(t) }
        line-progress(t) => { root.line-progress(t) }
    }

    queue-layer := QueueDrawer {
        x: parent.width - root.queue-width;
        y: 0px;
        width: root.queue-width;
        height: root.height - 96px;
        visible: root.queue-open;
        palette: root.palette;
        tab: root.queue-tab;
        locked: root.queue-locked;
        total-count: root.queue-count;
        rows-all: root.queue-all;
        rows-searched: root.queue-searched;
        rows-continue: root.queue-continue;
        rows-auto: root.queue-auto;
        close-clicked => { root.queue-open = false; root.queue-closed(); }
        lock-clicked => { root.queue-lock-toggled(); }
        tab-selected(t) => { root.queue-tab-selected(t); }
        row-play(i) => { root.queue-play-requested(i); }
        row-remove(i) => { root.queue-remove-requested(i); }
        drag-start(i, y) => { root.drag-start(i, y); }
        drag-move(y) => { root.drag-move(y); }
        drag-end => { root.drag-end(); }
    }

    sleep-layer := SleepTimerDialog {
        width: 100%;
        height: 100%;
        visible: root.player-dialog == 1;
        palette: root.palette;
        mode: root.sleep-mode;
        minutes: root.sleep-minutes;
        minutes-selected(m) => { root.sleep-selected(1, m); }
        end-of-song-selected => { root.sleep-selected(2, 0); }
        off-selected => { root.sleep-selected(0, 0); }
        dismissed => { root.player-dialog = 0; root.player-dialog-dismissed(); }
    }

    tempo-layer := TempoPitchDialog {
        width: 100%;
        height: 100%;
        visible: root.player-dialog == 2;
        palette: root.palette;
        semitones <=> root.tempo-semitones;
        mult <=> root.tempo-mult;
        commit => { root.tempo-committed(); }
        reset => { root.tempo-reset(); }
        dismissed => { root.player-dialog = 0; root.player-dialog-dismissed(); }
    }

    eq-layer := EqualizerDialog {
        width: 100%;
        height: 100%;
        visible: root.player-dialog == 3;
        palette: root.palette;
        eq-on: root.eq-on;
        gains: root.eq-gains;
        preset-name: root.eq-preset;
        toggled(on) => { root.eq-toggled(on); }
        band-changed(i, v) => { root.eq-band-changed(i, v); }
        preset-selected(p) => { root.eq-preset-selected(p); }
        dismissed => { root.player-dialog = 0; root.player-dialog-dismissed(); }
    }

    error-layer := PlaybackErrorDialog {
        width: 100%;
        height: 100%;
        visible: root.player-dialog == 4;
        palette: root.palette;
        code: root.error-code;
        message: root.error-message;
        retry => { root.error-retried(); }
        dismissed => { root.player-dialog = 0; root.player-dialog-dismissed(); }
    }

    info-layer := StreamInfoPanel {
        width: 100%;
        height: 100%;
        visible: root.player-dialog == 5;
        palette: root.palette;
        codec: root.stream-codec;
        bitrate: root.stream-bitrate;
        sample-rate: root.stream-rate;
        loudness: root.stream-loudness;
        buffer: root.stream-buffer;
        state: root.stream-state;
        dismissed => { root.player-dialog = 0; root.player-dialog-dismissed(); }
    }
}
