import { Palette, Light, Dark, PureBlack, Type } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { LibSongRow, LibPlaylistRow, LibCardRow, HistoryRow, StatRow, DownloadRow } from "../pages/library/models.slint";
import { SideNav } from "sidebar.slint";
import { PageHost } from "pagehost.slint";
import { ConfirmOverlay, PromptOverlay } from "overlays.slint";

export component MainShell inherits Window {
    in-out property<Palette> palette: Light.palette;
    in-out property<int> theme-kind: 0;
    in-out property<int> page: 0;
    in-out property<int> overlay: 0;
    in-out property<bool> sidebar-focused: false;
    in-out property<bool> search-focused: false;
    in-out property<int> queue-count: 0;
    in-out property<[string]> lib-chips;
    in-out property<int> lib-tab: 0;
    in-out property<bool> lib-chip-edit: false;
    in-out property<[string]> lib-tags;
    in-out property<string> lib-active-tag: "";
    in-out property<[LibSongRow]> lib-songs;
    in-out property<[LibPlaylistRow]> lib-playlists;
    in-out property<[LibCardRow]> lib-cards;
    in-out property<[string]> lib-sort-options;
    in-out property<int> lib-sort: 0;
    in-out property<bool> lib-sort-open: false;
    in-out property<bool> lib-multiselect: false;
    in-out property<int> lib-selected-count: 0;
    in-out property<bool> lib-tags-open: false;
    in-out property<string> lib-tag-input: "";
    in-out property<[HistoryRow]> lib-history;
    in-out property<bool> lib-history-paused: false;
    in-out property<[StatRow]> lib-stat-tracks;
    in-out property<[StatRow]> lib-stat-artists;
    in-out property<[StatRow]> lib-stat-albums;
    in-out property<string> lib-stats-totals: "";
    in-out property<string> lib-stats-streaks: "";
    in-out property<[string]> lib-years;
    in-out property<int> lib-year: 0;
    in-out property<[DownloadRow]> dl-rows;
    in-out property<[DownloadRow]> dl-failed;
    in-out property<int> lib-action-count: 0;
    in-out property<string> lib-last-action: "";
    in-out property<int> dl-action-count: 0;
    in-out property<string> dl-last-action: "";
    in-out property<string> confirm-title: "";
    in-out property<string> confirm-body: "";
    in-out property<int> confirm-result: -1;
    in-out property<string> prompt-title: "";
    in-out property<string> prompt-input: "";
    in-out property<string> prompt-result: "";
    in-out property<int> play-toggle-count: 0;
    in-out property<int> seek-back-count: 0;
    in-out property<int> seek-fwd-count: 0;
    in-out property<int> seek-delta: 0;
    in-out property<int> next-count: 0;
    in-out property<int> prev-count: 0;
    in-out property<int> full-player-count: 0;
    in-out property<int> search-focus-count: 0;

    callback apply-theme(int);
    callback navigate(int);
    callback open-confirm(string, string);
    callback open-prompt(string);
    callback close-overlay();
    callback confirm-accepted();
    callback confirm-dismissed();
    callback prompt-accepted(string);
    callback prompt-dismissed();
    callback handle-key(string) -> bool;
    callback play-pause-toggled();
    callback seek-requested(int);
    callback next-requested();
    callback prev-requested();
    callback full-player-opened();
    callback search-focus-requested();
    callback lib-chip-selected(int);
    callback lib-chip-move-left();
    callback lib-chip-move-right();
    callback lib-chip-edit-toggled();
    callback lib-tag-selected(string);
    callback lib-tags-opened();
    callback lib-tags-closed();
    callback lib-tag-created(string);
    callback lib-tag-removed(string);
    callback lib-sort-opened();
    callback lib-sort-closed();
    callback lib-sort-selected(int);
    callback lib-song-toggled(string);
    callback lib-song-chosen(string);
    callback lib-multiselect-toggled();
    callback lib-selection-cleared();
    callback lib-playlist-opened(string);
    callback lib-history-cleared();
    callback lib-year-prev();
    callback lib-year-next();
    callback dl-pause(string);
    callback dl-resume(string);
    callback dl-cancel(string);
    callback dl-retry(string);
    callback dl-retry-all();

    function lib-record(action: string) {
        root.lib-action-count += 1;
        root.lib-last-action = action;
    }

    function dl-record(action: string) {
        root.dl-action-count += 1;
        root.dl-last-action = action;
    }

    lib-chip-selected(i) => {
        root.lib-record("chip-selected");
        root.lib-tab = i;
    }
    lib-chip-move-left() => { root.lib-record("chip-move-left"); }
    lib-chip-move-right() => { root.lib-record("chip-move-right"); }
    lib-chip-edit-toggled() => {
        root.lib-record("chip-edit-toggled");
        root.lib-chip-edit = !root.lib-chip-edit;
    }
    lib-tag-selected(t) => {
        root.lib-record("tag-selected");
        root.lib-active-tag = t;
    }
    lib-tags-opened() => {
        root.lib-record("tags-opened");
        root.lib-tags-open = true;
    }
    lib-tags-closed() => {
        root.lib-record("tags-closed");
        root.lib-tags-open = false;
    }
    lib-tag-created(t) => { root.lib-record("tag-created"); }
    lib-tag-removed(t) => { root.lib-record("tag-removed"); }
    lib-sort-opened() => {
        root.lib-record("sort-opened");
        root.lib-sort-open = true;
    }
    lib-sort-closed() => {
        root.lib-record("sort-closed");
        root.lib-sort-open = false;
    }
    lib-sort-selected(i) => {
        root.lib-record("sort-selected");
        root.lib-sort = i;
        root.lib-sort-open = false;
    }
    lib-song-toggled(id) => { root.lib-record("song-toggled"); }
    lib-song-chosen(id) => { root.lib-record("song-chosen"); }
    lib-multiselect-toggled() => {
        root.lib-record("multiselect-toggled");
        root.lib-multiselect = !root.lib-multiselect;
    }
    lib-selection-cleared() => { root.lib-record("selection-cleared"); }
    lib-playlist-opened(id) => { root.lib-record("playlist-opened"); }
    lib-history-cleared() => { root.lib-record("history-cleared"); }
    lib-year-prev() => {
        root.lib-record("year-prev");
        if (root.lib-year > 0) {
            root.lib-year -= 1;
        }
    }
    lib-year-next() => {
        root.lib-record("year-next");
        if (root.lib-year < root.lib-years.length - 1) {
            root.lib-year += 1;
        }
    }
    dl-pause(id) => { root.dl-record("dl-pause"); }
    dl-resume(id) => { root.dl-record("dl-resume"); }
    dl-cancel(id) => { root.dl-record("dl-cancel"); }
    dl-retry(id) => { root.dl-record("dl-retry"); }
    dl-retry-all() => { root.dl-record("dl-retry-all"); }

    apply-theme(k) => {
        if (k == 0) {
            root.palette = Light.palette;
        } else if (k == 1) {
            root.palette = Dark.palette;
        } else {
            root.palette = PureBlack.palette;
        }
        root.theme-kind = k;
    }

    navigate(p) => {
        root.page = p;
    }

    open-confirm(t, b) => {
        root.confirm-title = t;
        root.confirm-body = b;
        root.confirm-result = -1;
        root.overlay = 1;
    }

    open-prompt(t) => {
        root.prompt-title = t;
        root.prompt-input = "";
        root.prompt-result = "";
        root.overlay = 2;
    }

    close-overlay() => {
        root.overlay = 0;
    }

    confirm-accepted() => {
        root.confirm-result = 1;
        root.overlay = 0;
    }

    confirm-dismissed() => {
        root.confirm-result = 0;
        root.overlay = 0;
    }

    prompt-accepted(text) => {
        root.prompt-result = text;
        root.overlay = 0;
    }

    prompt-dismissed() => {
        root.overlay = 0;
    }

    handle-key(key) => {
        if (key == "Escape") {
            if (root.overlay == 1) {
                root.confirm-dismissed();
                return true;
            }
            if (root.overlay == 2) {
                root.prompt-dismissed();
                return true;
            }
            root.sidebar-focused = true;
            return true;
        }
        if (root.overlay != 0) {
            return false;
        }
        if (key == " ") {
            root.play-toggle-count += 1;
            root.play-pause-toggled();
            return true;
        }
        if (key == "Left") {
            root.seek-back-count += 1;
            root.seek-delta = -10;
            root.seek-requested(-10);
            return true;
        }
        if (key == "Right") {
            root.seek-fwd-count += 1;
            root.seek-delta = 10;
            root.seek-requested(10);
            return true;
        }
        if (key == "n" || key == "N") {
            root.next-count += 1;
            root.next-requested();
            return true;
        }
        if (key == "p" || key == "P") {
            root.prev-count += 1;
            root.prev-requested();
            return true;
        }
        if (key == "f" || key == "F") {
            root.full-player-count += 1;
            root.full-player-opened();
            return true;
        }
        if (key == "/") {
            root.search-focus-count += 1;
            root.search-focused = true;
            root.search-focus-requested();
            return true;
        }
        if (key == "]") {
            if (root.page >= 5) {
                root.page = 0;
            } else {
                root.page += 1;
            }
            return true;
        }
        if (key == "[") {
            if (root.page <= 0) {
                root.page = 5;
            } else {
                root.page -= 1;
            }
            return true;
        }
        if (key == "1") {
            root.page = 0;
            return true;
        }
        if (key == "2") {
            root.page = 1;
            return true;
        }
        if (key == "3") {
            root.page = 2;
            return true;
        }
        if (key == "4") {
            root.page = 3;
            return true;
        }
        if (key == "5") {
            root.page = 4;
            return true;
        }
        if (key == "6") {
            root.page = 5;
            return true;
        }
        return false;
    }

    title: "madrigal-shell";
    width: 960px;
    height: 640px;
    background: root.palette.surface;

    main-row := HorizontalLayout {
        spacing: 0px;
        nav := SideNav {
            width: 232px;
            palette: root.palette;
            page: root.page;
            focused: root.sidebar-focused;
            navigate(p) => { root.navigate(p); }
        }
        content-col := VerticalLayout {
            spacing: 0px;
            host := PageHost {
                vertical-stretch: 1;
                palette: root.palette;
                page: root.page;
                lib-chips: root.lib-chips;
                lib-tab: root.lib-tab;
                lib-chip-edit: root.lib-chip-edit;
                lib-tags: root.lib-tags;
                lib-active-tag: root.lib-active-tag;
                lib-songs: root.lib-songs;
                lib-playlists: root.lib-playlists;
                lib-cards: root.lib-cards;
                lib-sort-options: root.lib-sort-options;
                lib-sort: root.lib-sort;
                lib-sort-open: root.lib-sort-open;
                lib-multiselect: root.lib-multiselect;
                lib-selected-count: root.lib-selected-count;
                lib-tags-open: root.lib-tags-open;
                lib-tag-input <=> root.lib-tag-input;
                lib-history: root.lib-history;
                lib-history-paused: root.lib-history-paused;
                lib-stat-tracks: root.lib-stat-tracks;
                lib-stat-artists: root.lib-stat-artists;
                lib-stat-albums: root.lib-stat-albums;
                lib-stats-totals: root.lib-stats-totals;
                lib-stats-streaks: root.lib-stats-streaks;
                lib-years: root.lib-years;
                lib-year: root.lib-year;
                dl-rows: root.dl-rows;
                dl-failed: root.dl-failed;
                lib-chip-selected(i) => { root.lib-chip-selected(i); }
                lib-chip-move-left() => { root.lib-chip-move-left(); }
                lib-chip-move-right() => { root.lib-chip-move-right(); }
                lib-chip-edit-toggled() => { root.lib-chip-edit-toggled(); }
                lib-tag-selected(t) => { root.lib-tag-selected(t); }
                lib-tags-opened() => { root.lib-tags-opened(); }
                lib-tags-closed() => { root.lib-tags-closed(); }
                lib-tag-created(t) => { root.lib-tag-created(t); }
                lib-tag-removed(t) => { root.lib-tag-removed(t); }
                lib-sort-opened() => { root.lib-sort-opened(); }
                lib-sort-closed() => { root.lib-sort-closed(); }
                lib-sort-selected(i) => { root.lib-sort-selected(i); }
                lib-song-toggled(id) => { root.lib-song-toggled(id); }
                lib-song-chosen(id) => { root.lib-song-chosen(id); }
                lib-multiselect-toggled() => { root.lib-multiselect-toggled(); }
                lib-selection-cleared() => { root.lib-selection-cleared(); }
                lib-playlist-opened(id) => { root.lib-playlist-opened(id); }
                lib-history-cleared() => { root.lib-history-cleared(); }
                lib-year-prev() => { root.lib-year-prev(); }
                lib-year-next() => { root.lib-year-next(); }
                dl-pause(id) => { root.dl-pause(id); }
                dl-resume(id) => { root.dl-resume(id); }
                dl-cancel(id) => { root.dl-cancel(id); }
                dl-retry(id) => { root.dl-retry(id); }
                dl-retry-all() => { root.dl-retry-all(); }
            }
            nowbar := Rectangle {
                height: 72px;
                background: root.palette.surface-container;
                nowbar-dot := Rectangle {
                    x: 16px;
                    y: 14px;
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: root.palette.secondary-container;
                }
                nowbar-text := Text {
                    x: 72px;
                    y: 0px;
                    width: parent.width - 88px;
                    height: 100%;
                    text: I18n.trl(I18n.lang, "player.noTrack") + " (" + root.queue-count + ")";
                    color: root.palette.on-surface-variant;
                    font-size: Type.body-medium.size;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    confirm-layer := ConfirmOverlay {
        width: 100%;
        height: 100%;
        visible: root.overlay == 1;
        palette: root.palette;
        title: root.confirm-title;
        body: root.confirm-body;
        accepted => { root.confirm-accepted(); }
        dismissed => { root.confirm-dismissed(); }
    }

    prompt-layer := PromptOverlay {
        width: 100%;
        height: 100%;
        visible: root.overlay == 2;
        palette: root.palette;
        title: root.prompt-title;
        input <=> root.prompt-input;
        accepted(text) => { root.prompt-accepted(text); }
        dismissed => { root.prompt-dismissed(); }
    }
}
