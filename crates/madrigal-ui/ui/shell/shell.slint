    in property<string> settings-test-result: "";
    in property<bool> settings-po-done: false;
    in property<bool> settings-po-ok: false;
    in property<bool> settings-account-connected: false;
    in property<string> settings-account-name: "";
    in property<string> settings-account-email: "";
    in property<bool> settings-account-busy: false;
    in property<string> settings-account-error: "";
