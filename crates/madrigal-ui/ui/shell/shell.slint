    in-out property<bool> lib-chip-edit: false;
    in-out property<[string]> lib-tags;
    in-out property<string> lib-active-tag: "";
    in-out property<[LibSongRow]> lib-songs;
    in-out property<[LibPlaylistRow]> lib-playlists;
