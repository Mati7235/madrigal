import { Palette, Type, Shape } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { Icon, Icons } from "../components/icons.slint";

export component SideNav inherits Rectangle {
    in property<Palette> palette;
    in property<int> page;
    in property<bool> expanded: true;
    callback navigate(int);

    public function focus-current() {
        if (root.page == 0) {
            home-focus.focus();
        } else if (root.page == 1) {
            search-focus.focus();
        } else if (root.page == 2) {
            explore-focus.focus();
        } else if (root.page == 3) {
            library-focus.focus();
        } else if (root.page == 4) {
            downloads-focus.focus();
        } else {
            settings-focus.focus();
        }
    }

    background: root.palette.surface-container-low;

    nav-col := VerticalLayout {
        padding: 16px;
        spacing: 6px;

        home-btn := Rectangle {
            height: 48px;
            border-radius: Shape.full;
            background: root.page == 0 ? root.palette.secondary-container : transparent;
            HorizontalLayout {
                alignment: root.expanded ? start : center;
                padding-left: root.expanded ? 16px : 0px;
                spacing: root.expanded ? 12px : 0px;
                Rectangle {
                    width: 22px;
                    VerticalLayout {
                        alignment: center;
                        home-glyph := Icon {
                            source: Icons.house;
                            colorize: root.page == 0 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                            icon-size: 22px;
                        }
                    }
                }
                if (root.expanded) : home-label := Text {
                    text: I18n.trl(I18n.lang, "nav.home");
                    color: root.page == 0 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                    font-size: Type.label-large.size;
                    font-family: Type.label-large.family;
                    font-weight: Type.label-large.weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            home-focus := FocusScope {
                focus-on-click: false;
                width: 100%;
                height: 100%;
                accessible-role: AccessibleRole.button;
                accessible-label: I18n.trl(I18n.lang, "nav.home");
                key-pressed(event) => {
                    if (event.text == Key.Space || event.text == Key.Return) {
                        root.navigate(0);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            nav-home := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(0); }
            }
            if (home-focus.has-focus) : home-focus-ring := Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: Shape.full - 2px;
                border-width: 2px;
                border-color: root.palette.primary;
            }
        }

        search-btn := Rectangle {
            height: 48px;
            border-radius: Shape.full;
            background: root.page == 1 ? root.palette.secondary-container : transparent;
            HorizontalLayout {
                alignment: root.expanded ? start : center;
                padding-left: root.expanded ? 16px : 0px;
                spacing: root.expanded ? 12px : 0px;
                Rectangle {
                    width: 22px;
                    VerticalLayout {
                        alignment: center;
                        search-glyph := Icon {
                            source: Icons.search;
                            colorize: root.page == 1 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                            icon-size: 22px;
                        }
                    }
                }
                if (root.expanded) : search-label := Text {
                    text: I18n.trl(I18n.lang, "explore.search");
                    color: root.page == 1 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                    font-size: Type.label-large.size;
                    font-family: Type.label-large.family;
                    font-weight: Type.label-large.weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            search-focus := FocusScope {
                focus-on-click: false;
                width: 100%;
                height: 100%;
                accessible-role: AccessibleRole.button;
                accessible-label: I18n.trl(I18n.lang, "explore.search");
                key-pressed(event) => {
                    if (event.text == Key.Space || event.text == Key.Return) {
                        root.navigate(1);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            nav-search := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(1); }
            }
            if (search-focus.has-focus) : search-focus-ring := Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: Shape.full - 2px;
                border-width: 2px;
                border-color: root.palette.primary;
            }
        }

        explore-btn := Rectangle {
            height: 48px;
            border-radius: Shape.full;
            background: root.page == 2 ? root.palette.secondary-container : transparent;
            HorizontalLayout {
                alignment: root.expanded ? start : center;
                padding-left: root.expanded ? 16px : 0px;
                spacing: root.expanded ? 12px : 0px;
                Rectangle {
                    width: 22px;
                    VerticalLayout {
                        alignment: center;
                        explore-glyph := Icon {
                            source: Icons.compass;
                            colorize: root.page == 2 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                            icon-size: 22px;
                        }
                    }
                }
                if (root.expanded) : explore-label := Text {
                    text: I18n.trl(I18n.lang, "nav.explore");
                    color: root.page == 2 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                    font-size: Type.label-large.size;
                    font-family: Type.label-large.family;
                    font-weight: Type.label-large.weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            explore-focus := FocusScope {
                focus-on-click: false;
                width: 100%;
                height: 100%;
                accessible-role: AccessibleRole.button;
                accessible-label: I18n.trl(I18n.lang, "nav.explore");
                key-pressed(event) => {
                    if (event.text == Key.Space || event.text == Key.Return) {
                        root.navigate(2);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            nav-explore := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(2); }
            }
            if (explore-focus.has-focus) : explore-focus-ring := Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: Shape.full - 2px;
                border-width: 2px;
                border-color: root.palette.primary;
            }
        }

        library-btn := Rectangle {
            height: 48px;
            border-radius: Shape.full;
            background: root.page == 3 ? root.palette.secondary-container : transparent;
            HorizontalLayout {
                alignment: root.expanded ? start : center;
                padding-left: root.expanded ? 16px : 0px;
                spacing: root.expanded ? 12px : 0px;
                Rectangle {
                    width: 22px;
                    VerticalLayout {
                        alignment: center;
                        library-glyph := Icon {
                            source: Icons.library;
                            colorize: root.page == 3 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                            icon-size: 22px;
                        }
                    }
                }
                if (root.expanded) : library-label := Text {
                    text: I18n.trl(I18n.lang, "nav.lists");
                    color: root.page == 3 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                    font-size: Type.label-large.size;
                    font-family: Type.label-large.family;
                    font-weight: Type.label-large.weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            library-focus := FocusScope {
                focus-on-click: false;
                width: 100%;
                height: 100%;
                accessible-role: AccessibleRole.button;
                accessible-label: I18n.trl(I18n.lang, "nav.lists");
                key-pressed(event) => {
                    if (event.text == Key.Space || event.text == Key.Return) {
                        root.navigate(3);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            nav-library := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(3); }
            }
            if (library-focus.has-focus) : library-focus-ring := Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: Shape.full - 2px;
                border-width: 2px;
                border-color: root.palette.primary;
            }
        }

        downloads-btn := Rectangle {
            height: 48px;
            border-radius: Shape.full;
            background: root.page == 4 ? root.palette.secondary-container : transparent;
            HorizontalLayout {
                alignment: root.expanded ? start : center;
                padding-left: root.expanded ? 16px : 0px;
                spacing: root.expanded ? 12px : 0px;
                Rectangle {
                    width: 22px;
                    VerticalLayout {
                        alignment: center;
                        downloads-glyph := Icon {
                            source: Icons.arrow-down;
                            colorize: root.page == 4 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                            icon-size: 22px;
                        }
                    }
                }
                if (root.expanded) : downloads-label := Text {
                    text: I18n.trl(I18n.lang, "nav.downloads");
                    color: root.page == 4 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                    font-size: Type.label-large.size;
                    font-family: Type.label-large.family;
                    font-weight: Type.label-large.weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            downloads-focus := FocusScope {
                focus-on-click: false;
                width: 100%;
                height: 100%;
                accessible-role: AccessibleRole.button;
                accessible-label: I18n.trl(I18n.lang, "nav.downloads");
                key-pressed(event) => {
                    if (event.text == Key.Space || event.text == Key.Return) {
                        root.navigate(4);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            nav-downloads := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(4); }
            }
            if (downloads-focus.has-focus) : downloads-focus-ring := Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: Shape.full - 2px;
                border-width: 2px;
                border-color: root.palette.primary;
            }
        }

        settings-btn := Rectangle {
            height: 48px;
            border-radius: Shape.full;
            background: root.page == 5 ? root.palette.secondary-container : transparent;
            HorizontalLayout {
                alignment: root.expanded ? start : center;
                padding-left: root.expanded ? 16px : 0px;
                spacing: root.expanded ? 12px : 0px;
                Rectangle {
                    width: 22px;
                    VerticalLayout {
                        alignment: center;
                        settings-glyph := Icon {
                            source: Icons.settings;
                            colorize: root.page == 5 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                            icon-size: 22px;
                        }
                    }
                }
                if (root.expanded) : settings-label := Text {
                    text: I18n.trl(I18n.lang, "settings.title");
                    color: root.page == 5 ? root.palette.on-secondary-container : root.palette.on-surface-variant;
                    font-size: Type.label-large.size;
                    font-family: Type.label-large.family;
                    font-weight: Type.label-large.weight;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            settings-focus := FocusScope {
                focus-on-click: false;
                width: 100%;
                height: 100%;
                accessible-role: AccessibleRole.button;
                accessible-label: I18n.trl(I18n.lang, "settings.title");
                key-pressed(event) => {
                    if (event.text == Key.Space || event.text == Key.Return) {
                        root.navigate(5);
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
            nav-settings := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.navigate(5); }
            }
            if (settings-focus.has-focus) : settings-focus-ring := Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: Shape.full - 2px;
                border-width: 2px;
                border-color: root.palette.primary;
            }
        }
    }
}
