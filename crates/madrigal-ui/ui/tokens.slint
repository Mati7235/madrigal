export struct TypeStyle {
    size: length,
    weight: int,
    tracking: length,
}

export global Type {
    out property<TypeStyle> display-large: { size: 57px, weight: 400, tracking: -0.2px };
    out property<TypeStyle> display-large-emphasized: { size: 57px, weight: 500, tracking: 0px };
    out property<TypeStyle> display-medium: { size: 45px, weight: 400, tracking: 0px };
    out property<TypeStyle> display-medium-emphasized: { size: 45px, weight: 500, tracking: 0px };
    out property<TypeStyle> display-small: { size: 36px, weight: 400, tracking: 0px };
    out property<TypeStyle> display-small-emphasized: { size: 36px, weight: 500, tracking: 0px };
    out property<TypeStyle> headline-large: { size: 32px, weight: 400, tracking: 0px };
    out property<TypeStyle> headline-large-emphasized: { size: 32px, weight: 500, tracking: 0px };
    out property<TypeStyle> headline-medium: { size: 28px, weight: 400, tracking: 0px };
    out property<TypeStyle> headline-medium-emphasized: { size: 28px, weight: 500, tracking: 0px };
    out property<TypeStyle> headline-small: { size: 24px, weight: 400, tracking: 0px };
    out property<TypeStyle> headline-small-emphasized: { size: 24px, weight: 500, tracking: 0px };
    out property<TypeStyle> title-large: { size: 22px, weight: 400, tracking: 0px };
    out property<TypeStyle> title-large-emphasized: { size: 22px, weight: 500, tracking: 0px };
    out property<TypeStyle> title-medium: { size: 16px, weight: 500, tracking: 0.2px };
    out property<TypeStyle> title-medium-emphasized: { size: 16px, weight: 700, tracking: 0.15px };
    out property<TypeStyle> title-small: { size: 14px, weight: 500, tracking: 0.1px };
    out property<TypeStyle> title-small-emphasized: { size: 14px, weight: 700, tracking: 0.1px };
    out property<TypeStyle> body-large: { size: 16px, weight: 400, tracking: 0.5px };
    out property<TypeStyle> body-large-emphasized: { size: 16px, weight: 500, tracking: 0.15px };
    out property<TypeStyle> body-medium: { size: 14px, weight: 400, tracking: 0.2px };
    out property<TypeStyle> body-medium-emphasized: { size: 14px, weight: 500, tracking: 0.25px };
    out property<TypeStyle> body-small: { size: 12px, weight: 400, tracking: 0.4px };
    out property<TypeStyle> body-small-emphasized: { size: 12px, weight: 500, tracking: 0.4px };
    out property<TypeStyle> label-large: { size: 14px, weight: 500, tracking: 0.1px };
    out property<TypeStyle> label-large-emphasized: { size: 14px, weight: 700, tracking: 0.1px };
    out property<TypeStyle> label-medium: { size: 12px, weight: 500, tracking: 0.5px };
    out property<TypeStyle> label-medium-emphasized: { size: 12px, weight: 700, tracking: 0.5px };
    out property<TypeStyle> label-small: { size: 11px, weight: 500, tracking: 0.5px };
    out property<TypeStyle> label-small-emphasized: { size: 11px, weight: 700, tracking: 0.5px };
}

export global Shape {
    out property<length> none: 0px;
    out property<length> extra-small: 4px;
    out property<length> small: 8px;
    out property<length> medium: 12px;
    out property<length> large: 16px;
    out property<length> large-increased: 20px;
    out property<length> extra-large: 28px;
    out property<length> extra-large-increased: 32px;
    out property<length> extra-extra-large: 48px;
    out property<length> full: 9999px;
}

